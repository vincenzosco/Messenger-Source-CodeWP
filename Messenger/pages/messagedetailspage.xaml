<pages:MessageDetailsViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.MessageDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:common="clr-namespace:Facebook.Messenger.WP8.Controls.Common"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:command="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Platform"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    x:Name="MessageDetailsViewPage">

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <common:MessageTopBar
            Margin="24,30,10,10"
            RecipientChatOrigin="{Binding RecipientChatOrigin}"
            ThreadName="{Binding ThreadName}"
            IsCanonical="{Binding IsSingleRecipient}"/>

        <ScrollViewer Grid.Row="1"
                      Margin="0,0,0,35">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="MapImageBorder"
                        Grid.Row="0"
                        Background="{StaticResource MessengerTextLightGreyBrush}"
                        Width="{Binding MessageViewModel.MapImageWidth}"
                        Height="{Binding MessageViewModel.MapImageHeight}"
                        Visibility="{Binding MessageViewModel.HasCoordinates, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image x:Name="MapImage"
                           HorizontalAlignment="Stretch"
                           Stretch="None"
                           Tap="MapImage_OnTap"
                           Source="{Binding MessageViewModel.MapImageUrl}"/>
                </Border>

                <controls:MessageDetailControl
                            Grid.Row="1"
                            DataContext="{Binding MessageViewModel}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MessageActionEvent">
                            <command:EventToCommand
                                    Command="{Binding DataContext.MessageActionCommand, ElementName=MessageDetailsViewPage}"
                                    PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="NavigateEvent">
                            <command:EventToCommand 
                        Command="{Binding DataContext.NavigateCommand, ElementName=MessageDetailsViewPage}" 
                        PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </controls:MessageDetailControl>
            </Grid>
        </ScrollViewer>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar ForegroundColor="{StaticResource MessengerAppBarWhite}"
                              BackgroundColor="{StaticResource MessengerBlue}"
                              Opacity="0.99"
                              Mode="Minimized"
                              IsVisible="False"/>
    </phone:PhoneApplicationPage.ApplicationBar>
</pages:MessageDetailsViewModelPage>