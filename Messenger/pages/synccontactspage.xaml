<pages:SyncContactsViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.SyncContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Background="{StaticResource MessengerWhiteBrush}"
    shell:SystemTray.IsVisible="False">

    <Grid
        x:Name="RootGrid"
        Margin="20,100,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <Image
            Source="/Assets/Icons/registration_sync_contacts.png" 
            VerticalAlignment="Center"       
            Width="310"
            Margin="0,40,0,50"/>
        
        <TextBlock
            Grid.Row="1"
            Margin="0,24,0,0"
            Text="{Binding StringLibrary.SyncContact_Title, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource MessengerBlackBrush}"
            FontSize="38"
            LineHeight="42"
            LineStackingStrategy="BlockLineHeight"
            FontFamily="Segoe WP SemiLight"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

        <RichTextBox
            x:Name="DescriptionRichTextBox"
            Grid.Row="2"
            Foreground="{StaticResource PhonePageTextGrayBrush}"
            Margin="10,8"
            FontSize="19"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar 
            Opacity="0.99"
             ForegroundColor="{StaticResource MessengerAppBarWhite}"
             BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>

</pages:SyncContactsViewModelPage>