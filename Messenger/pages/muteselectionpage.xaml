<pages:MuteSelectionViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.MuteSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:command="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Platform"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d">

    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
            Background="{StaticResource MessageBubbleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--TitlePanel contains the name of the application and page title-->
        <TextBlock 
            Grid.Row="0"
            Margin="20,48,20,0"
            FontSize="24"
            FontWeight="SemiBold"
            Text="{Binding StringLibrary.MainPage_AppBar_Mute_Button, Source={StaticResource LocalizedStrings}, Converter={StaticResource StringAllCapsConverter}}" 
            Foreground="Black"/>

        <!--ContentPanel - place additional content here-->
        <ListBox 
            Grid.Row="1"
            Margin="20,10"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ItemsSource="{Binding MenuItems}"
            extensions:TiltEffect.IsTiltEnabled="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Tap">
                                <command:EventToCommand 
                                        Command="{Binding Command}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <TextBlock
                            Foreground="{StaticResource MessengerBlackBrush}"
                            FontFamily="{StaticResource PhoneFontFamilySemiLight}"
                            FontSize="36"
                            Margin="0,18"
                            Text="{Binding Name}">
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <controls:FBMessengerProgressBar
                x:Name="BusyIndicator"
                Height="10"
                VerticalAlignment="Top"
                IsIndeterminate="{Binding IsLoading}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>

</pages:MuteSelectionViewModelPage>