<pages:SuggestedPinsViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.SuggestedPinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d">

    <pages:SuggestedPinsViewModelPage.Resources>
        <Style x:Key="SearchBoxText" TargetType="TextBox" BasedOn="{StaticResource LoginTextBoxStyle2}">
            <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeMedium}"/>
            <Setter Property="Padding"  Value="10,9,3,2"/>
        </Style>

        <Style x:Key="SearchHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeMedium}"/>
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </pages:SuggestedPinsViewModelPage.Resources>
    
    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:FBMessengerProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                         IsIndeterminate="{Binding IsLoading}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Top"
                                         Height="10" />

        <controls:StateIndicatingProgressBar x:Name="StateProgressBar"
                                             IsIndeterminate="{Binding IsEnabled, ElementName=SearchGroupsTextBox, Converter={StaticResource InverseBoolConverter}}"
                                             HorizontalAlignment="Stretch"
                                             Margin="24, 0"
                                             VerticalAlignment="Top"/>

        <TextBlock Grid.Row="0"
                Margin ="20,56,20,8"
                Text="{Binding StringLibrary.SuggestedPins_Title_PinGroup, Source={StaticResource LocalizedStrings}}"
                Foreground="{StaticResource MessengerBlackBrush}"
                FontSize="22"
                FontWeight="Medium" />

        <base:HintTextBox
                Grid.Row="1"
                Margin="20, 0"
                x:Name="SearchGroupsTextBox"                    
                Hint="{Binding StringLibrary.SuggestedPins_SearchBox_Hint, Source={StaticResource LocalizedStrings}}"
                TextBoxTextChanged="SearchGroupsTextBox_OnTextBoxTextChanged"
                HintBorderThickness="3"
                TextBoxStyle="{StaticResource SearchBoxText}"
                HintStyle="{StaticResource SearchHintText}"/>
        
        <base:FacebookListView Grid.Row="2"
              Margin ="20,10,20,0"
              x:Name="SearchList"
              ItemsSource="{Binding SearchResults}">
            <base:FacebookListView.ItemTemplate>
                <DataTemplate>
                    <controls:ThreadParticipantControl Tap="OnItemTapped" />
                </DataTemplate>
            </base:FacebookListView.ItemTemplate>
        </base:FacebookListView>

        <TextBlock
            x:Name="EmptyStateTextBlock"
            Grid.Row="2"
            Margin="0,20,0,0"
            Visibility="Collapsed"
            TextAlignment="Center"
            Foreground="{StaticResource MessengerBlackBrush}"
            Style="{StaticResource NuxTitleFontStyle}"
            Text="{Binding StringLibrary.Contact_Search_No_Results, Source={StaticResource LocalizedStrings}}"/>
    </Grid>

</pages:SuggestedPinsViewModelPage>