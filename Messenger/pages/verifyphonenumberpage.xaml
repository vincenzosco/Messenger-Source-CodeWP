<pages:VerifyPhoneNumberViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.VerifyPhoneNumberPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Unloaded="OnUnLoaded">

    <!--LayoutRoot is the root grid where all page content is placed-->
        <Grid x:Name="LayoutRoot"
          Background="{StaticResource MessengerWhiteBrush}"
          Margin="24,0,24,0"
          HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border 
            Name="TitleTopMargin" 
            Grid.Row="0">
            <Image
                    Name="Logo"
                    Source="/Assets/Icons/bunny.png"
                    VerticalAlignment="Top"
                    Stretch="None"
                    Margin="-20,50,0,0"/>
        </Border>
        <TextBlock
                    Name="SignInTitle"
                    Grid.Row="1"
                    Text="{Binding StringLibrary.LoginApproval_Title_EnterCode, Source={StaticResource LocalizedStrings}}"
                    Foreground="Black"
                    FontSize="38"
                    LineStackingStrategy="BlockLineHeight"
                    LineHeight="42"
                    FontFamily="Segoe WP SemiLight"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>

        <HyperlinkButton Content="{Binding StringLibrary.LoginApproval_ResendCode, Source={StaticResource LocalizedStrings}}"
                Margin="0,5,0,0"
                Grid.Row="2"
                Style="{StaticResource HyperlinkButtonStyle}"
                Click="SendCodeAgain_OnClick"
                Foreground="Black"/>
        
        <Grid 
            Grid.Row="3"
            Margin="0,36,0,0"
            Visibility="{Binding PhoneNumber, Converter={StaticResource StringLengthToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock 
                Grid.Row="0"
                Text="{Binding StringLibrary.Verify_PhoneNumber_Box_Title, Source={StaticResource LocalizedStrings} }"
                Foreground="{StaticResource MessengerTextLightGreyBrush}"/>
            <TextBox
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Style="{StaticResource LoginTextBoxStyle2}"
                    FontSize="26"
                    Text="{Binding PhoneNumber}"
                    Tap="PhoneNumberOnTap"/>
        </Grid>
        
        <Grid Grid.Row="4"
                  VerticalAlignment="Top"
                  Margin="0,24,0,0"
                  Name="ConfirmCodeFormContainer" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock 
                Grid.Row="0"
                Text="{Binding StringLibrary.Login_Approval_Security_Code, Source={StaticResource LocalizedStrings} }"
                Foreground="{StaticResource MessengerTextLightGreyBrush}"/>
            <TextBox
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    x:Name="ConfirmCodeTextBox" 
                    Style="{StaticResource LoginTextBoxStyle2}"
                    KeyDown="ConfirmCodeTextBox_KeyDown"
                    TextChanged="ConfirmCodeTextBox_TextChanged"
                    InputScope="NumericPassword"
                    Width="155"
                    FontSize="26"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                    GotFocus="ConfirmCodeTextBox_OnGotFocus"
                    LostFocus="ConfirmCodeTextBox_OnLostFocus"
                    HorizontalAlignment="Left"
                    Text="{Binding ConfirmCode, Mode=TwoWay}"/>
        </Grid>

        <controls:FBMessengerProgressBar 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsIndeterminate="{Binding IsLoading}"
                    HorizontalAlignment="Center" 
                    Width="400"
                    Grid.Row="0" 
                    VerticalAlignment="Top"
                    Height="10" />
    </Grid>
    
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar
            Opacity="0.99"
            ForegroundColor="{StaticResource MessengerAppBarWhite}"
            BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>

</pages:VerifyPhoneNumberViewModelPage>