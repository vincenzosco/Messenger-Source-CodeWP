<pages:StickerPackViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.StickerStorePackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    xmlns:viewModels="clr-namespace:Facebook.Messenger.WP8.ViewModels"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModels:StickerStorePackViewModel}">
    
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20">
            <TextBlock
                x:Name="ArtistTextBlock"
                FontSize="22"
                Margin="0 26 0 0"
                Text="{Binding StickerPack.Artist, Converter={StaticResource StringAllCapsConverter}}"
                HorizontalAlignment="Left"/>
            <TextBlock
                x:Name="NameTextBlock"
                Margin="0 6 0 10"
                FontSize="64"
                Text="{Binding StickerPack.Name, Converter={StaticResource StringAllLowerCaseConverter}}"
                FontFamily="{StaticResource PhoneFontFamilySemiLight}"
                CharacterSpacing="-10"
                HorizontalAlignment="Left"/>
            <TextBlock
                x:Name="DescriptionTextBlock"
                Foreground="{StaticResource MessengerTextLightGreyBrush}"
                Text="{Binding StickerPack.Description}"
                HorizontalAlignment="Left"
                TextWrapping="Wrap"/>
            <controls:FBMessengerProgressBar
                x:Name="DownloadProgressBar"
                Height="20"
                Minimum="0"
                Maximum="100"
                IsIndeterminate="{Binding StickerPack.HasDownloadProgress, Converter={StaticResource InverseBoolConverter}}"
                Value="{Binding StickerPack.DownloadProgress}"/>
        </StackPanel>

        
        <ScrollViewer Grid.Row="1">
            <Image
                Name="PreviewImage"
                extensions:ImageCacheExtensions.ImageUri="{Binding StickerPack.PreviewImage.Url}"
                Margin="20 10 20 20"/>
        </ScrollViewer>
        <Border
            Grid.Row="2"
            Background="{StaticResource MessengerBlueBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="DownloadButton"
                    Margin="20 14 10 14"
                    Style="{StaticResource WhiteButtonStyle}"
                    Click="OnDownloadButtonClicked"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="DownloadButtonTextBlock"
                        Text="{Binding StickerPack.DownloadStateText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"/>
                </Button>
                
                <Button
                    x:Name="RemoveButton"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Margin="10 14 20 14"
                    Style="{StaticResource WhiteButtonStyle}"
                    IsEnabled="{Binding IsLoading, Converter = {StaticResource InverseBoolConverter}}"
                    Click="OnRemoveButtonClicked"
                    Command="{Binding RemoveCommand}">
                    <TextBlock
                        x:Name="RemoveButtonTextBlock"
                        Text="{Binding StringLibrary.Sticker_Store_ContextMenu_Remove, Source={StaticResource LocalizedStrings}}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"/>
                </Button>
                        
            </Grid>
        </Border>
    </Grid>
</pages:StickerPackViewModelPage>