<pages:LoginViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.LoginApprovalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Loaded="OnLoaded"
    Unloaded="OnUnLoaded"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="false"
    mc:Ignorable="d"
    Background="{StaticResource MessengerWhiteBrush}">

    <pages:LoginViewModelPage.Resources>
        <Storyboard x:Name="FadeIn">
            <DoubleAnimation Storyboard.TargetName="Logo"
                         Storyboard.TargetProperty="Opacity" From="0.0"
                         To="1.0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="TitleTopMargin"
                         Storyboard.TargetProperty="Height" From="0.0"
                         To="235.0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Name="FadeOut">
            <DoubleAnimation Storyboard.TargetName="Logo"
                         Storyboard.TargetProperty="Opacity" From="1.0"
                         To="0.0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="TitleTopMargin"
                         Storyboard.TargetProperty="Height" From="150.0"
                         To="0.0" Duration="0:0:0.1" />
        </Storyboard>
    </pages:LoginViewModelPage.Resources>

    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Background="{StaticResource MessengerWhiteBrush}"
           Margin="24,0,24,0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="235"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border 
            Name="TitleTopMargin" 
            Grid.Row="0">
            <Image
                    Name="Logo"
                    Margin="-17,52,0,0"
                    Source="/Assets/Icons/bunny.png" 
                    VerticalAlignment="Top"
                    Stretch="None"/>
        </Border>
       
        <TextBlock
                    Name="SignInTitle"
                    Grid.Row="2"
                    Text="{Binding StringLibrary.LoginApproval_Title_EnterCode, Source={StaticResource LocalizedStrings}}"
                    Foreground="Black"
                    Margin="0,24,0,6"
                    FontSize="38"
                    LineHeight="42"
                    LineStackingStrategy="BlockLineHeight"
                    FontFamily="Segoe WP SemiLight"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>

        <HyperlinkButton Content="{Binding StringLibrary.LoginApproval_ResendCode, Source={StaticResource LocalizedStrings}}"
                Margin="0"
                Grid.Row="3"
                Style="{StaticResource HyperlinkButtonStyle}"
                Command="{Binding ResendApprovalCodeCommand}"
                Foreground="Black"/>
        
        <Grid Grid.Row="4"
                  VerticalAlignment="Top"
                  Margin="0,36,0,0"
                  Name="LoginFormContainer" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock
                    Grid.Row="0"
                    x:Name="ApprovalHintTextBlock"
                    Text="{Binding StringLibrary.Login_Approval_Security_Code, Source={StaticResource LocalizedStrings} }"
                    Foreground="{StaticResource MessengerTextLightGreyBrush}"
                    Tap="ApprovalHintTextBlock_OnTap"
                    VerticalAlignment="Center"
                    Visibility="{Binding ApprovalCode, Converter={StaticResource StringLengthToVisibilityConverter}, ConverterParameter=1}"/>
            <TextBox
                    Grid.Row="1"
                    x:Name="ApprovalTextBox" 
                    Style="{StaticResource LoginTextBoxStyle2}"
                    InputScope="NumericPassword"
                    KeyDown="PasswordTextBox_KeyDown"
                    GotFocus="ApprovalTextBox_OnGotFocus"
                    LostFocus="ApprovalTextBox_OnLostFocus"
                    HorizontalAlignment="Stretch"
                    Margin="0,5,0,0"
                    Text="{Binding ApprovalCode, Mode=TwoWay}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" TextChanged="ApprovalTextboxOnTextChanged"/>
        </Grid>

        <controls:FBMessengerProgressBar 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsIndeterminate="{Binding IsLoading}"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Width="400"
                    Grid.Row="0" 
                    Height="10" />

    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar ForegroundColor="{StaticResource MessengerAppBarWhite}"
                              BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>
</pages:LoginViewModelPage>