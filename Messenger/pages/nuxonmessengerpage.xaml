<pages:NuxOnMessengerViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.NuxOnMessengerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    shell:SystemTray.IsVisible="false"
    Background="{StaticResource MessengerWhiteBrush}">

    <Grid Name="LayoutRoot"
              Background="{StaticResource MessengerWhiteBrush}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Margin="0,-35,0,0"
              >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border 
            Name="TitleTopMargin">
            <Grid Width="212" Height="212">

                <Image Name="ProfilePhoto"
                    Stretch="UniformToFill"
                    extensions:ImageCacheExtensions.ImageUri="{Binding Path=CurrentUser.Id, Converter={StaticResource ProfilePhotoConverter}, ConverterParameter=212}"
                    extensions:ImageCacheExtensions.PlaceholderUri="/Assets/Messages/Silhouette.png"
                    extensions:RoundContentExtension.Radius="106"/>
                <Image
                    Name="Logo"
                    Source="/Assets/Icons/Icon-Medium.png" 
                    VerticalAlignment="bottom"
                    HorizontalAlignment="Right"
                    Stretch="None"
                    Margin="0"/>
                
            </Grid>
        </Border>
        <TextBlock
            Grid.Row="1"
            Name="WelcomeTitle"
            Margin="0,34,0,0"
            Text="{Binding StringLibrary.Nux_Title_OnMessenger, Source={StaticResource LocalizedStrings}}"
            Foreground="Black"
            FontSize="39"
            FontFamily="Segoe WP SemiLight"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            Grid.Row="2"
            FontSize="20"
            Margin="0,5,0,0"
            Foreground="{StaticResource MessengerTextLightGreyBrush}"
            Text="{Binding StringLibrary.Nux_Title_OnMessenger_Message, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"/>
        <MediaElement x:Name="NuxSound"/>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar 
            Opacity="0.99"
             ForegroundColor="{StaticResource MessengerAppBarWhite}"
                              BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>
</pages:NuxOnMessengerViewModelPage>
