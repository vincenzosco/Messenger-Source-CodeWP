<pages:ExistingUserViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.ExistingUserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Background="{StaticResource MessengerWhiteBrush}"
    shell:SystemTray.IsVisible="False">

    <Grid Name="LayoutRoot"
              Background="{StaticResource MessengerWhiteBrush}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border 
            Name="TitleTopMargin"
            Margin="0,60,0,0"
            Width="212"
            Height="212">
            <Image Name="ProfilePhoto"
                Stretch="UniformToFill"
                extensions:ImageCacheExtensions.ImageUri="{Binding Path=ProfilePicUrl}"
                extensions:ImageCacheExtensions.PlaceholderUri="/Assets/Messages/Silhouette.png"
                extensions:RoundContentExtension.Radius="106"/>
        </Border>
        <TextBlock
            Grid.Row="1"
            Name="TitleTextBlock"
            Margin="0,34,0,0"
            Text="{Binding StringLibrary.ExistingUser_Title, Source={StaticResource LocalizedStrings}}"
            Foreground="Black"
            FontSize="39"
            FontFamily="Segoe WP SemiLight"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="DescriptionTextBlock"
            Grid.Row="2"
            FontSize="20"
            Margin="20,5"
            Foreground="{StaticResource MessengerTextLightGreyBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Stretch"/>
        
        <Grid
            Grid.Row="3"
            Margin="20,40"
            HorizontalAlignment="Center"
            MinWidth="240">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Button
                Margin="0,0,0,20"
                Style="{StaticResource BlueButtonStyle}"
                Content="{Binding StringLibrary.ExistingUser_Create_Account_Button,Source={StaticResource LocalizedStrings}}"
                Command="{Binding CreateNewAccountCommand}"/>

            <Button
                x:Name="LoginAsUserButton"
                Grid.Row="1"
                Style="{StaticResource BlueButtonStyle}" 
                Command="{Binding LogInAsUserCommand}"/>
            
        </Grid>
        
    </Grid>
    
</pages:ExistingUserViewModelPage>