<pages:PhoneNumberViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.PhoneNumberPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:common="clr-namespace:Facebook.Messenger.WP8.Controls.Common"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    Loaded="OnLoaded"
    Unloaded="OnUnLoaded"
    mc:Ignorable="d"
    Background="{StaticResource MessengerWhiteBrush}">

    <pages:PhoneNumberViewModelPage.Resources>
        <phone:JumpListItemBackgroundConverter Enabled="{StaticResource MessengerBlueBrush}"
                                           Disabled="{StaticResource MessengerWhiteBrush}"
                                           x:Key="JumpListItemBackgroundConverter" />
        <phone:JumpListItemForegroundConverter Enabled="{StaticResource MessengerWhiteBrush}"
                                           Disabled="{StaticResource MessengerTransparentBlueBrush}"
                                           x:Key="JumpListItemForegroundConverter" />
        <Style x:Key="CountryCodeJumpListItemStyle"
               TargetType="phone:LongListSelector">
            <Setter Property="Background" 
                    Value="{StaticResource MessengerWhiteBrush}" />
            <Setter Property="Padding"
                    Value="0,0,0,0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="GridCellSize"
                    Value="115,115" />
            <Setter Property="LayoutMode"
                    Value="Grid" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource JumpListItemBackgroundConverter}}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                Margin="20,10,0,10">

                            <TextBlock Text="{Binding Key}"
                                FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                                FontSize="48"
                                Foreground="{Binding Converter={StaticResource JumpListItemForegroundConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountyCodeListHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PhoneFontFamilyNormal}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MessengerTextBlackBrush}"/>
        </Style>

        <DataTemplate x:Name="CountryCodeDataTemplate">
            <Grid Margin="2,0,0,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                       FontSize="36"
                       FontFamily="Segoe WP SemiLight"
                       Text="{Binding Path=CountryName}"
                       Foreground="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}"
                       TextWrapping="Wrap"
                       Tap="CountryCodeListItem_OnTap"/>
                <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       FontFamily="Segoe WP SemiLight"
                       FontSize="36"
                       Text="{Binding Path=PhonePrefixWithPlus}"
                       Foreground="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}"
                       TextAlignment="Right"
                       Tap="CountryCodeListItem_OnTap"/>
            </Grid>

        </DataTemplate>

        <DataTemplate x:Name="GroupedCountryCodeHeaderTemplate">
            <Grid Width="62"
                  Height="62"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,26">
                <Border Background="{StaticResource ListHeaderBackgroundGrayBrush}"
                        Height="62"
                        Width="62">
                    <TextBlock Text="{Binding Key}"
                           Foreground="Black"
                           FontSize="48"
                           Margin="8,0,0,2"
                           FontFamily="Segoe WP SemiLight"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" />
                </Border>

            </Grid>
        </DataTemplate>
    </pages:PhoneNumberViewModelPage.Resources>

    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Popup Name="CountryCodeListPopup"
               IsOpen="False"
               Opened="CountryCodeListPopup_OnOpened"
               Closed="CountryCodeListPopup_OnClosed">
            <Grid Name="CountryCodeListGrid"
                  Background="{StaticResource MessengerWhiteBrush}"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="20,46,20,0"
                           Style="{StaticResource CountyCodeListHeader}"
                           Text="{Binding StringLibrary.PhoneNumber_ListpickerLabel_CountryCode, Source={StaticResource LocalizedStrings}}"/>
                <base:FacebookListView Name="CountryCodeList"
                                       JumpListStyle="{StaticResource CountryCodeJumpListItemStyle}"
                                       toolkit:TiltEffect.IsTiltEnabled="True"
                                       Loaded="CountryCodeList_OnLoaded"
                                       Margin="20, 20, 12, 0"
                                       Grid.Row="1"
                                       IsGroupingEnabled="True"
                                       HideEmptyGroups="True"
                                       ItemsSource="{Binding AlphaGroupedCountryCodes}"
                                       ItemTemplate="{StaticResource CountryCodeDataTemplate}"
                                       GroupHeaderTemplate="{StaticResource GroupedCountryCodeHeaderTemplate}"
                                       SelectedItem="{Binding CountryCode}"/>
            </Grid>
        </Popup>

        <controls:FBMessengerProgressBar 
                    x:Name="MessengerProgressBar"
                    Grid.Row="0"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsIndeterminate="{Binding IsLoading}"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Width="400"
                    Height="10" />
        
        <ScrollViewer Grid.Row="1"
                      Margin = "0,0,0,72">
            <Grid Background="{StaticResource MessengerWhiteBrush}"
                  Margin="24,0,24,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="235"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Name="TitleTopMargin">
                    <Image
                        Name="Logo"
                        Source="/Assets/Icons/bunny.png" 
                        VerticalAlignment="Center"
                        Stretch="None"
                        Margin="0,30,20,0"/>
                </Border>
                <TextBlock
                        Name="SignInTitle"
                        Grid.Row="1"
                        Margin="0,24,0,0"
                        Text="{Binding PhoneNumberTitle}"
                        Foreground="Black"
                        FontSize="38"
                        LineHeight="42"
                        LineStackingStrategy="BlockLineHeight"
                        FontFamily="Segoe WP SemiLight"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"/>
                <TextBlock
                        Grid.Row="2"
                        Text="{Binding PhoneNumberInstructions}"
                        Foreground="{StaticResource PhonePageTextGrayBrush}"
                        FontSize="20"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"/>
                <TextBlock
                        Grid.Row="3"
                        Text="{Binding PhoneNumberInstructionsTwo}"
                        Foreground="{StaticResource PhonePageTextGrayBrush}"
                        Visibility="{Binding PhoneNumberInstructionsTwo, Converter={StaticResource StringLengthToVisibilityConverter}}"
                        FontSize="20"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"/>

                <Grid Grid.Row="4"
                      VerticalAlignment="Top"
                      Name="PhoneFormContainer" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="35*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock 
                            Margin="0,24,0,0"
                            Grid.Row="0"
                            Text="{Binding StringLibrary.PhoneNumber_Select_Country, Source={StaticResource LocalizedStrings} }"
                            Foreground="{StaticResource PhonePageTextGrayBrush}" Grid.ColumnSpan="2"/>

                    <TextBox Name="CountryCodeListPicker"
                             Margin= "0,5,0,0"
                             Grid.Row="1"
                             IsHitTestVisible="False"
                             Style="{StaticResource LoginTextBoxStyle2}"
                             Text="{Binding ValidatedCountryCode.CountryName, Mode=OneWay}" Grid.ColumnSpan="2"/>
                    <Button Grid.Row="1"
                            Margin="0"
                            BorderThickness="0"
                            Opacity="0"
                            IsHitTestVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Background="Transparent"
                            Tap="CountryCodeListPicker_OnTap" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="2"
                                Text="{Binding StringLibrary.PhoneNumber_Box_Title, Source={StaticResource LocalizedStrings} }"
                                Foreground="{StaticResource PhonePageTextGrayBrush}" Grid.ColumnSpan="2"
                                Margin="0,18,0,0"/>

                    <Grid x:Name="PhoneNumberGrid"
                          Grid.Row="3"
                          Margin="0,5,0,0"
                          FlowDirection="LeftToRight"
                          Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                                Grid.Column="0"
                                x:Name="PhonePrefixTextBox"
                                Margin="0,0,10,0"
                                Width="80"
                                Style="{StaticResource LoginTextBoxStyle2}"
                                Text="{Binding PrefixWithPlus}"
                                IsHitTestVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                FlowDirection="LeftToRight"
                                LostFocus="PhonePrefixTextBoxOnLostFocus"
                                InputScope="TelephoneAreaCode"
                                MaxLength="4"/>
                        <TextBox
                                Grid.Column="1"
                                x:Name="PhoneNumberTextBox"
                                IsHitTestVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                Text="{Binding MyPhoneNumber, Mode=TwoWay}"
                                Style="{StaticResource LoginTextBoxStyle2}"
                                KeyUp="PhoneNumberTextBox_KeyUp"
                                GotFocus="PhoneNumberForm_OnGotFocus"
                                LostFocus="PhoneNumberForm_OnLostFocus"
                                FlowDirection="LeftToRight"
                                InputScope="TelephoneAreaCode"/>
                    </Grid>

                </Grid>
            </Grid>
        </ScrollViewer>

        <common:FullscreenProgressIndicatorWithButton
            Grid.Row="0"
            Grid.RowSpan="2"
            x:Name="FullscreenProgressIndicator"
            IsIndeterminate="True"
            ShowButton="False"
            ButtonTapped="RetryButtonOnTapped"/>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar 
            IsVisible="False"
            Opacity="0.99"
            ForegroundColor="{StaticResource MessengerAppBarWhite}"
            BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>
</pages:PhoneNumberViewModelPage>