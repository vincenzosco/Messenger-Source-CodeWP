<pages:AddProfilePicViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.AddProfilePicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Background="{StaticResource MessengerWhiteBrush}"
    shell:SystemTray.IsVisible="False"
    BackKeyPress="OnBackKeyPress">

    <Grid x:Name="LayoutRoot">
        <Grid
            x:Name="ContentGrid"
            Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Name="TitleTopMargin">
                <Image
                    Name="Logo"
                    Width="200"
                    Source="/Assets/Icons/registration_selfie.png" 
                    VerticalAlignment="Center"
                    Margin="0,30,20,0"/>
            </Border>

            <TextBlock
            Name="SignInTitle"
            Grid.Row="1"
            Margin="41,24,33,0"
            Text="{Binding StringLibrary.ProfilePic_Title_Text, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource MessengerBlackBrush}"
            FontSize="38"
            LineHeight="42"
            LineStackingStrategy="BlockLineHeight"
            FontFamily="Segoe WP SemiLight"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

            <TextBlock
            Grid.Row="2"
            Text="{Binding StringLibrary.ProfilePic_Subtitle_Text, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource PhonePageTextGrayBrush}"
            Margin="0,8,0,0"
            FontSize="19"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

            <Button Grid.Row="3"
            x:Name="TakePhotoButton"
            HorizontalAlignment="Stretch"
            Margin="18,32,18,16"
            Tap="TakePhoto_OnTap"
            Style="{StaticResource BareTiltButton}"
            HorizontalContentAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image
                        x:Name="TakePhotoIconBlack"
                        Grid.Column="0"
                        Source="/Assets/Groups/photoFromCamera.png" />

                    <TextBlock x:Name="TakePhotoText"
                    Margin="19,0,21,0"
                    Grid.Column="1"
                    Foreground="Black"
                    Text="{Binding StringLibrary.ProfilePic_Label_Camera_Button, Source={StaticResource LocalizedStrings}}"
                    FontFamily="Segoe WP SemiLight"
                    FontSize="34"
                    TextWrapping="Wrap"/>
                </Grid>
            </Button>

            <Button 
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Margin="18,16"
            Tap="ChoosePhoto_OnTap"
            Style="{StaticResource BareTiltButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image
                    x:Name="AttachImageIconBlack"
                    Grid.Column="0"
                    Source="/Assets/Groups/photoFromGallery.png" />

                    <TextBlock x:Name="AttachImageText"
                    Margin="20,0,20,0"
                    Grid.Column="1"
                    Foreground="Black"
                    Text="{Binding StringLibrary.ProfilePic_Label_Gallery_Button, Source={StaticResource LocalizedStrings}}"
                    FontFamily="Segoe WP SemiLight"
                    FontSize="34"
                    TextWrapping="Wrap"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar 
            Opacity="0.99"
             ForegroundColor="{StaticResource MessengerAppBarWhite}"
             BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>
</pages:AddProfilePicViewModelPage>