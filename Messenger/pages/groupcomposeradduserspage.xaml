<pages:GroupComposerAddUsersViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.GroupComposerAddUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:common="clr-namespace:Facebook.Messenger.WP8.Controls.Common"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d">

    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Background="White"
          Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:FBMessengerProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                         IsIndeterminate="{Binding IsLoading}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Top"
                                         Height="10" />
        
        <TextBlock Grid.Row="0"
                   Margin ="24,56,24,0"
                   Text="{Binding StringLibrary.Group_AddPeople_Title, Source={StaticResource LocalizedStrings}}"
                   Foreground="{StaticResource MessengerBlackBrush}"
                   FontSize="22"
                   FontWeight="Medium" />

        <Border x:Name="ContactSearch"
                VerticalAlignment="Top"
                Margin="24,0"
                Grid.Row="1"
                Height="75">

            <TextBox x:Name="SearchTextBox"
                     VerticalAlignment="Top"
                     Margin="0,15,0,0"
                     Height="60"
                     Style="{StaticResource ContactSearchTextBoxStyle}"
                     TextChanged="ContactSearchFilterChanged"
                     GotFocus="SearchTextBox_OnGotFocus"
                     LostFocus="SearchTextBox_OnLostFocus"
                     Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
        </Border>

        <Grid Grid.Row="2"
              Margin ="20,10,20,0"
              x:Name="SearchGrid">

            <base:FacebookListView x:Name="SelectedUsers"
                                   ItemsSource="{Binding SelectedUsers}"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding Path=Filter, Converter={StaticResource StringLengthToVisibilityConverter}, ConverterParameter=1}">

                <base:FacebookListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <controls:ContactUserControl Grid.Column="0"
                                                         NameFontSize="{StaticResource PhoneFontSizeLarge}"
                                                         ImageSize="62"
                                                         ShowDeselectOption="True"
                                                         OnDeselected="DeselectedMember"/>

                        </Grid>
                    </DataTemplate>
                </base:FacebookListView.ItemTemplate>
                <base:FacebookListView.ListFooter>
                    <Border Background="White"
                            Height="12"></Border>
                </base:FacebookListView.ListFooter>
            </base:FacebookListView>

            <Grid x:Name="SearchOverlayGrid"
                  IsHitTestVisible="True"
                  Tap="OnOverlayGridTapped"
                  Visibility="Collapsed"
                  Background="#a0ffffff" />

            <base:FacebookListView x:Name="ContactsSearchResults"
                                   ItemsSource="{Binding SearchResults}"
                                   IsGroupingEnabled="True"
                                   GroupHeaderTemplate="{StaticResource ContactGroupHeaderTemplate}"
                                   HideEmptyGroups="True"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding Path=Filter, Converter={StaticResource StringLengthToVisibilityConverter}}">

                <base:FacebookListView.ItemTemplate>
                    <DataTemplate>
                        <controls:ContactUserControl NameFontSize="{StaticResource PhoneFontSizeLarge}"
                                                     ImageSize="62"
                                                     Tap="OnItemTapped" />
                    </DataTemplate>
                </base:FacebookListView.ItemTemplate>
                <base:FacebookListView.ListFooter>
                    <Border Background="White"
                            Height="12"></Border>
                </base:FacebookListView.ListFooter>
            </base:FacebookListView>
        </Grid>
        
        <common:FullscreenProgressIndicator
            Grid.Row="0"
            Grid.RowSpan="3"
            x:Name="FullscreenProgressIndicator"
            Text="{Binding StringLibrary.SuggestedPins_Pinning_StateIndicator, Source={StaticResource LocalizedStrings}}"
            Visibility="Collapsed"/>
    </Grid>
    
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar ForegroundColor="{StaticResource MessengerAppBarWhite}"
                              BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>

</pages:GroupComposerAddUsersViewModelPage>