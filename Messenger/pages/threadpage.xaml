<pages:MessagesViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.ThreadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:command="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Platform"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:common="clr-namespace:Facebook.Messenger.WP8.Controls.Common"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    x:Name="ThreadViewPage" Margin="0">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="NavigateEvent">
            <command:EventToCommand Command="{Binding NavigateCommand}" PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid x:Name="SecondLayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <common:MessageTopBar 
                Grid.Row="0"
                x:Name="TopBar"
                Margin="24,30,10,10"
                Tap="TopBar_OnTap"
                TiltEnabled="True"
                RecipientChatOrigin="{Binding RecipientChatOrigin}"/>
            
            <base:FacebookListView x:Name="MessageList"
                                   Grid.Row="1"
                                   RenderTransformOrigin="0.5, 0.5"
                                   Style="{StaticResource FloatingScrollbarStyle}"
                                   ItemsSource="{Binding Messages}">

                <base:FacebookListView.RenderTransform>
                    <ScaleTransform ScaleY="-1"/>
                </base:FacebookListView.RenderTransform>

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="ListEvent">
                        <command:EventToCommand Command="{Binding ListEventCommand}" PassEventArgsToCommand="True"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
             
                <base:FacebookListView.ItemTemplate>
                    <DataTemplate>
                        <controls:MessageControl
                                CanRetry="{Binding DataContext.CanSendToThread, ElementName=ThreadViewPage}"
                                RenderTransformOrigin="0.5, 0.5">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MessageActionEvent">
                                    <command:EventToCommand
                                    Command="{Binding DataContext.MessageActionCommand, ElementName=ThreadViewPage}"
                                    PassEventArgsToCommand="True"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="NavigateEvent">
                                    <command:EventToCommand
                                    Command="{Binding DataContext.NavigateCommand, ElementName=ThreadViewPage}"
                                    PassEventArgsToCommand="True"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <controls:MessageControl.RenderTransform>
                                <ScaleTransform ScaleY="-1"/>
                            </controls:MessageControl.RenderTransform>
                        </controls:MessageControl>
                    </DataTemplate>
                </base:FacebookListView.ItemTemplate>

                <base:FacebookListView.ListHeader>
                    <Grid x:Name="ListHeaderGrid" 
                          Loaded="OnListHeaderGridLoaded" 
                          RenderTransformOrigin="0.5, 0.5">

                        <Grid.RenderTransform>
                            <ScaleTransform ScaleY="-1"/>
                        </Grid.RenderTransform>

                        <Grid x:Name="NestedListHeaderGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition MinHeight="5"/>
                            </Grid.RowDefinitions>

                            <controls:TypingIndicator
                                x:Name="TypingIndicator"
                                Visibility="Collapsed"/>

                            <Grid
                                x:Name="ComposerBubbleComponents"
                                Grid.Row="1">
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <controls:LocationNuxControl
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"/>

                                <Button
                                    x:Name="FocusButton"
                                    Width="0" 
                                    Height="0"
                                    Grid.Row="1"
                                    Grid.Column="1"/>

                                <Button
                                    Name="LocationButton"
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Click="LocationButtonOnClick"
                                    IsEnabled="{Binding IsLoadingLocation, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource BareTiltButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0, 0, 6, 16"
                                    Height="40"
                                    Width="40">
                                    <Grid>
                                        <Image
                                            x:Name="LocationButtonDisabledImage"
                                            Source="../Assets/Messages/LocationDisabled.png"
                                            Stretch="None"
                                            Visibility="{Binding SendLocationEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1}"/>    
                                        <Image
                                            x:Name="LocationButtonEnabledImage"
                                            Source="../Assets/Messages/LocationEnabled.png"
                                            Stretch="None" 
                                            Visibility="{Binding SendLocationEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>

                                <controls:MessageComposerBubble
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    x:Name="MessageComposerBubble"
                                    Margin="0,10,0,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </base:FacebookListView.ListHeader>
            </base:FacebookListView>

            <StackPanel Orientation="Vertical"
                        Visibility="{Binding EmptyTitleText, Converter={StaticResource StringLengthToVisibilityConverter}}"
                        Grid.Row="1"
                        VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" 
                           Margin="0,-20,0,5"
                           Text="{Binding EmptyTitleText}"
                           Foreground="Black"
                           FontFamily="Segoe WP SemiLight"
                           TextWrapping="Wrap"
                           FontSize="38"/>
                <TextBlock TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="30,0"
                           Foreground="{StaticResource MessengerTextLightGreyBrush}"
                           FontFamily="Segoe WP SemiLight"
                           FontSize="20"
                           Text="{Binding EmptyText}"/>
            </StackPanel>

            <Grid x:Name="DrawerPaddingElement"
                  Grid.Row="3"/>
            
            <controls:DrawerContainer x:Name="Container"
                                      Grid.Row="0"
                                      Grid.RowSpan="4"/>

        </Grid>

        <controls:FBMessengerProgressBar
                x:Name="BusyIndicator"
                Height="10"
                VerticalAlignment="Top"
                IsIndeterminate="{Binding IsLoading}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar ForegroundColor="{StaticResource MessengerAppBarWhite}"
                              BackgroundColor="{StaticResource MessengerBlue}"/>
    </phone:PhoneApplicationPage.ApplicationBar>
</pages:MessagesViewModelPage>