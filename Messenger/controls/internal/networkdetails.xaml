<UserControl x:Class="Facebook.Messenger.WP8.Controls.Internal.NetworkDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:internal="clr-namespace:Facebook.Messenger.WP8.ViewModels.Internal"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DataContext="{d:DesignInstance internal:NetworkInterfaceDetailsViewModel}"
    d:DesignHeight="480" d:DesignWidth="480">

    <ListBox ItemsSource="{Binding NetworkInterfaces}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid
                    Margin="0, 0, 0, 50">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock 
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InternalStringsLibrary.Internal_Network_Settings_InterfaceName, Source={StaticResource LocalizedStrings} }"/>
                    
                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InterfaceName}"
                        TextWrapping="Wrap"
                        Grid.Column="1"/>
                    
                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InternalStringsLibrary.Internal_Network_Settings_ConnectionState, Source={StaticResource LocalizedStrings}}"
                        Grid.Row="1"/>
                    <TextBlock 
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InterfaceState}"
                        Grid.Row="1"
                        Grid.Column="1"/>
                    
                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InternalStringsLibrary.Internal_Network_Settings_InterfaceType, Source={StaticResource LocalizedStrings}}"
                        Grid.Row="2"/>
                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InterfaceType}"
                        Grid.Row="2"
                        Grid.Column="1"/>

                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InternalStringsLibrary.Internal_Network_Settings_Bandwidth, Source={StaticResource LocalizedStrings}}"
                        Grid.Row="3"/>
                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding Bandwidth}"
                        Grid.Row="3"
                        Grid.Column="1"/>

                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InternalStringsLibrary.Internal_Network_Settings_Subtype, Source={StaticResource LocalizedStrings}}"
                        Grid.Row="4"/>
                    <TextBlock
                        FontSize="{StaticResource PhoneFontSizeLarge}"
                        Text="{Binding InterfaceSubtype}"
                        Grid.Row="4"
                        Grid.Column="1"/>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</UserControl>