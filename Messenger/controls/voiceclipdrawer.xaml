<controls:ComposerDrawer x:Class="Facebook.Messenger.WP8.Controls.VoiceClipDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    IsTabStop="True"
    d:DesignHeight="330">

    <UserControl.Resources>
        <system:Double x:Key="ContentVerticalOffset">-120</system:Double>
        <Style x:Key="AboveButtonStyle" TargetType="TextBlock">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform
                        Y="{StaticResource ContentVerticalOffset}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <system:Double x:Key="CircleDiameterToFillDrawer">700</system:Double>
        <system:Double x:Key="ButtonSize">125</system:Double>
        <system:Double x:Key="PressedButtonSize">115</system:Double>
    </UserControl.Resources>
    <Grid
        Background="{StaticResource MessengerBackgroundGreyBrush}">

        <Ellipse
            Name="AnimationEffectRedCircle"
            IsHitTestVisible="False"
            Fill="{StaticResource MessengerRecordActiveBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Height="{StaticResource ButtonSize}"
            Width="{StaticResource ButtonSize}"/>

        <Ellipse
            Name="AnimationEffectLightCircle"
            IsHitTestVisible="False"
            Fill="{StaticResource MessengerBackgroundGreyBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Height="0"
            Width="0"/>

        <Ellipse
            Name="VisualRecordButton"
            IsHitTestVisible="False"
            Fill="{StaticResource MessengerRecordActiveBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Height="{StaticResource ButtonSize}"
            Width="{StaticResource ButtonSize}"/>

        <Ellipse
            Name="RecordButtonHitArea"
            Fill="Transparent"
            MouseLeftButtonDown="RecordButton_OnLeftMouseButtonDown"
            MouseLeftButtonUp="RecordButton_OnLeftMouseButtonUp"
            MouseMove="RecordButton_OnMouseMove"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Height="{StaticResource ButtonSize}"
            Width="{StaticResource ButtonSize}"/>

        <TextBlock
            Name="RecordingText"
            Text="{Binding StringLibrary.Voice_Clip_Record, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource MessengerWhiteBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False">
        </TextBlock>

        <TextBlock
            Name="TimerText"
            Margin="20,0"
            Foreground="{StaticResource MessengerTextDarkGreyBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{StaticResource AboveButtonStyle}"/>

        <TextBlock
            Name="CancelStateText"
            Text="{Binding StringLibrary.Voice_Clip_Release_Cancel, Source={StaticResource LocalizedStrings}}"
            Opacity="0"
            Margin="20,0"
            Foreground="{StaticResource MessengerWhiteBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{StaticResource AboveButtonStyle}"/>

        <TextBlock
            Name="DurationLimitText"
            Text="{Binding StringLibrary.Voice_Clip_Length_Limit, Source={StaticResource LocalizedStrings}}"
            Opacity="0"
            Margin="20,0"
            Foreground="{StaticResource MessengerTextDarkGreyBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{StaticResource AboveButtonStyle}"/>

        <TextBlock
            Name="TooShortInstructionText"
            Text="{Binding StringLibrary.Voice_Clip_Hold_Instruction, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource MessengerTextDarkGreyBrush}"
            Opacity="0"
            Margin="20,0"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{StaticResource AboveButtonStyle}"/>
        
        <TextBlock
            Name="DurationLimitInstructionText"
            Text="{Binding StringLibrary.Voice_Clip_Length_Limit, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource MessengerTextDarkGreyBrush}"
            Opacity="0"
            Margin="20,0"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{StaticResource AboveButtonStyle}"/>

        <TextBlock
            Name="NewUserInstructionText"
            Text="{Binding StringLibrary.Voice_Clip_NUX_Instruction, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource MessengerTextDarkGreyBrush}"
            Opacity="0"
            Margin="20,0"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{StaticResource AboveButtonStyle}"/>

        <Grid.Resources>
            <Storyboard
                x:Name="RecordingStateAnimation">
                <DoubleAnimation
                    x:Name="CompressedCircle"
                    Storyboard.TargetName="VisualRecordButton"
                    Storyboard.TargetProperty="Height"
                    To="{StaticResource PressedButtonSize}"
                    Duration="0:0:0.1"/>
                <DoubleAnimation
                    Storyboard.TargetName="VisualRecordButton"
                    Storyboard.TargetProperty="Width"
                    To="{StaticResource PressedButtonSize}"
                    Duration="{Binding Duration, ElementName=CompressedCircle}"/>
                <DoubleAnimation
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Height"
                    To="{StaticResource PressedButtonSize}"
                    Duration="{Binding Duration, ElementName=CompressedCircle}"/>
                <DoubleAnimation
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Width"
                    To="{StaticResource PressedButtonSize}"
                    Duration="{Binding Duration, ElementName=CompressedCircle}"/>
            </Storyboard>
            <Storyboard
                x:Name="MoveTimerUpAnimation">
                <DoubleAnimation
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="UIElement.RenderTransform.TranslateTransform.Y"
                    To="{StaticResource ContentVerticalOffset}"
                    Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase
                            Oscillations="1"
                            Springiness="7"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard
                x:Name="MoveTimerDownAnimation">
                <DoubleAnimation
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="UIElement.RenderTransform.TranslateTransform.Y"
                    To="0"
                    Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase
                            Oscillations="1"
                            Springiness="7"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="FontSize"
                    To="24"
                    Duration="0"/>
                <DoubleAnimation
                    Storyboard.TargetName="RecordingText"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0"/>
            </Storyboard>
            <Storyboard
                x:Name="RecordingRedTimerText">
                <ColorAnimation
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="TextBlock.Foreground.Color"
                    To="{StaticResource MessengerRecordActiveColor}"                    
                    Duration="0"/>
            </Storyboard>
            <Storyboard
                x:Name="RecordingTimelimitReachedAnimation">
                <ColorAnimation
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="TextBlock.Foreground.Color"
                    To="{StaticResource MessengerWhite}"                    
                    Duration="0"/>
                <DoubleAnimation
                    Storyboard.TargetName="DurationLimitText"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0" />
            </Storyboard>
            <Storyboard
                x:Name="CancelStateAnimation">
                <DoubleAnimation
                    Storyboard.TargetName="VisualRecordButton"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0"/>

                <DoubleAnimation
                    x:Name="FillRed"
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Height"
                    To="{StaticResource CircleDiameterToFillDrawer}"
                    Duration="0:0:0.1"/>
                <DoubleAnimation
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Width"
                    To="{StaticResource CircleDiameterToFillDrawer}"
                    Duration="{Binding Duration, ElementName=FillRed}"/>
                
                <DoubleAnimation
                    Storyboard.TargetName="CancelStateText"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0"/>

                <DoubleAnimation
                    x:Name="CircleInflate"
                    Storyboard.TargetName="AnimationEffectLightCircle"
                    Storyboard.TargetProperty="Height"
                    From="0"
                    To="{StaticResource ButtonSize}"
                    Duration="0:0:0.75">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase 
                            Oscillations="1"
                            Springiness="6"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="AnimationEffectLightCircle"
                    Storyboard.TargetProperty="Width"
                    From="0"
                    To="{StaticResource ButtonSize}"
                    Duration="{Binding Duration, ElementName=CircleInflate}"
                    BeginTime="{Binding BeginTime, ElementName=CircleInflate}"
                    EasingFunction="{Binding EasingFunction, ElementName=CircleInflate}"/>
            </Storyboard>
            <Storyboard
                x:Name="IdleStateAnimation">
                <DoubleAnimation
                    x:Name="ResetRed"
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Height"
                    To="{StaticResource ButtonSize}"
                    Duration="0:0:0.1"/>
                <DoubleAnimation
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Width"
                    To="{StaticResource ButtonSize}"
                    Duration="{Binding Duration, ElementName=ResetRed}"/>
            </Storyboard>
            <Storyboard
                x:Name="TooShortInstructionAnimation">
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="TooShortInstructionText"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame
                        KeyTime="0"
                        Value="1"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:2.5"
                        Value="1"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:3"
                        Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame
                        KeyTime="0"
                        Value="0"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:3"
                        Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard
                x:Name="SendAnimation"
                Duration="0:0:0.5">
                <DoubleAnimation
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0"/>
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Width">
                    <LinearDoubleKeyFrame
                        KeyTime="0"
                        Value="{StaticResource ButtonSize}"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:0.2"
                        Value="{StaticResource CircleDiameterToFillDrawer}"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:0.2"
                        Value="{StaticResource CircleDiameterToFillDrawer}"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:0.4"
                        Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="AnimationEffectRedCircle"
                    Storyboard.TargetProperty="Height">
                    <LinearDoubleKeyFrame
                        KeyTime="0"
                        Value="{StaticResource ButtonSize}"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:0.2"
                        Value="{StaticResource CircleDiameterToFillDrawer}"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:0.2"
                        Value="{StaticResource CircleDiameterToFillDrawer}"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:0.4"
                        Value="0"/>
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimation
                    x:Name="RestoreBackground"
                    Storyboard.TargetName="AnimationEffectLightCircle"
                    Storyboard.TargetProperty="Width"
                    From="0"
                    To="{StaticResource CircleDiameterToFillDrawer}"
                    BeginTime="0:0:0.175"
                    Duration="0:0:0.2"/>
                <DoubleAnimation
                    Storyboard.TargetName="AnimationEffectLightCircle"
                    Storyboard.TargetProperty="Height"
                    From="{Binding From, ElementName=RestoreBackground}"
                    To="{StaticResource CircleDiameterToFillDrawer}"
                    BeginTime="{Binding BeginTime, ElementName=RestoreBackground}"
                    Duration="{Binding Duration, ElementName=RestoreBackground}"/>

                <DoubleAnimation
                    Storyboard.TargetName="RecordingText"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0"/>
                <DoubleAnimation
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0"/>

                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="VisualRecordButton"
                    Storyboard.TargetProperty="Width">
                    <DiscreteDoubleKeyFrame
                        KeyTime="0"
                        Value="0"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:0.35"
                        Value="0"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:0.5"
                        Value="{StaticResource ButtonSize}"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="VisualRecordButton"
                    Storyboard.TargetProperty="Height">
                    <DiscreteDoubleKeyFrame
                        KeyTime="0"
                        Value="0"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:0.35"
                        Value="0"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:0.5"
                        Value="{StaticResource ButtonSize}"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard
                x:Name="NewUserInstructionAnimation">
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="NewUserInstructionText"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:1.5"
                        Value="0"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:2"
                        Value="1"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:5"
                        Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="TimerText"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:1.5"
                        Value="1"/>
                    <LinearDoubleKeyFrame
                        KeyTime="0:0:2"
                        Value="0"/>
                    <DiscreteDoubleKeyFrame
                        KeyTime="0:0:5"
                        Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>
    </Grid>

</controls:ComposerDrawer>