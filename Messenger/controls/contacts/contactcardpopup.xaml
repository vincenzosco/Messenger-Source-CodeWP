<controls:FacebookPopup x:Class="Facebook.Messenger.WP8.Controls.Contacts.ContactCardPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">
    
    <Grid x:Name="ContactPopupControl" Background="{StaticResource MessengerWhiteBrush}">
        <StackPanel Margin="21,0,21,21">
            <TextBlock 
                    FontSize="72" 
                    Foreground="Black" 
                    Text="contact"
                    FontFamily="Segoe WP SemiLight"
                    Margin="0,5,0,5"
                    TextWrapping="Wrap"/>
            
            <Grid Width="160" 
                    Height="160"
                    Margin ="0,20">

                <Image 
                        extensions:ImageCacheExtensions.ImageUri="{Binding Path=Id, Converter={StaticResource ProfilePhotoConverter}, ConverterParameter=160}"
                        extensions:ImageCacheExtensions.PlaceholderUri="/Assets/Messages/Silhouette.png"
                        Stretch="UniformToFill"
                        extensions:RoundContentExtension.Radius="80"/>
                <Image
                        Name="Logo"
                        Source="/Assets/Icons/Icon-Normal.png" 
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Stretch="None"
                        Margin="0,0,5,5"/>
            </Grid>

            <TextBlock 
                    FontSize="37" 
                    Foreground="Black" 
                    Text="{Binding Name}"
                    FontFamily="Segoe WP SemiLight"
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,10"
                    TextWrapping="Wrap"
                    TextAlignment="Center"/>

            <TextBlock x:Name="PhoneNumberTextBlock" 
                        FontSize="22" 
                        Text="{Binding Phones, Converter={StaticResource PhoneNumberFromPhoneInfoConverter}}"
                        Foreground="{StaticResource MessengerTextLightGreyBrush}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"/>

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource BareTiltButton}"
                    Click="SendMessage_OnClick">
                <TextBlock x:Name="SendMessageTextBlock" 
                            FontSize="34" 
                            FontFamily="Segoe WP SemiLight"
                            Foreground="{StaticResource MessengerBlackBrush}"
                            Margin="0,10"
                            TextWrapping="Wrap"/>
            </Button>
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource BareTiltButton}"
                    Click ="CreateGroup_OnClick">
                <TextBlock x:Name="CreateGroupTextBlock" 
                        FontSize="34" 
                        FontFamily="Segoe WP SemiLight"
                        Foreground="{StaticResource MessengerBlackBrush}"
                        Margin="0,10"
                        TextWrapping="Wrap"/>
            </Button>
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource BareTiltButton}"
                    Click="RemoveContact_OnClick">
                <TextBlock x:Name="RemoveContactTextBlock" 
                        FontSize="34" 
                        FontFamily="Segoe WP SemiLight"
                        Foreground="{StaticResource MessengerBlackBrush}"
                        Text="{Binding StringLibrary.ContactCard_MenuLabel_RemoveContact, Source={StaticResource LocalizedStrings}}"
                        Margin="0,10"
                        TextWrapping="Wrap"/>
            </Button>
        </StackPanel>
    </Grid>
</controls:FacebookPopup>