<UserControl x:Class="Facebook.Messenger.WP8.Controls.MessageBubbleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    Hold="OnBubbleHold"
    extensions:TiltEffect.IsTiltEnabled="True"
    d:DesignHeight="240" d:DesignWidth="480">
    
    <Grid x:Name="ContentGrid"
            HorizontalAlignment="Right">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="Auto"/>
            <ColumnDefinition x:Name="ContentColumn" Width="*"/>
            <ColumnDefinition x:Name="RightColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="ForwardButton"
                Height="40"
                Width="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                toolkit:TiltEffect.SuppressTilt="True"
                Tap="ForwardButton_OnTap"
                Style="{StaticResource ForwardMessageButtonStyle}"/>

        <controls:BubbleContainer x:Name="BubbleContainer"
                                Grid.Column="1">
            <Grid 
                x:Name="RootGrid"
                SizeChanged="RootGrid_OnSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentPresenter 
                    x:Name="StickerPresenter" 
                    Visibility="Collapsed"/>

                <RichTextBox
                    Margin="-7,0"
                    x:Name="Body"
                    MinHeight="31"
                    TextWrapping="Wrap"
                    Foreground="Black"
                    FontSize="{StaticResource PhoneFontSizeMedium}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Grid.Row="0">
                    <Paragraph x:Name="MessageTextParagraph" LineHeight="31" LineStackingStrategy="BlockLineHeight"/>
                </RichTextBox>

                <ContentPresenter 
                    x:Name="ImageAttachmentPresenter" 
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"/>

                <ContentPresenter 
                    x:Name="GenericFileAttachmentPresenter" 
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Margin="4"
                    Visibility="Collapsed"/>

                <ContentPresenter 
                    x:Name="AudioPresenter" 
                    Grid.Row="1" 
                    Margin="-10"
                    Height="51"
                    Visibility="Collapsed"/>

                <ContentPresenter 
                    x:Name="VideoPresenter"
                    Grid.Row="1"
                    Visibility="Collapsed"/>

                <ContentPresenter 
                    x:Name="SharePresenter"
                    Grid.Row="1"
                    Visibility="Collapsed"/>

                <HyperlinkButton
                    Grid.Row="2"
                    Padding="0,10,0,0"
                    x:Name="ViewMoreButton"
                    Content="view more"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Click="ViewMoreButton_OnClick"/>
            </Grid>
        </controls:BubbleContainer>
        
        <ContentPresenter 
            x:Name="VideoUploadOverlayPresenter"
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            Visibility="Collapsed"
            Margin="8,0"/>
    </Grid>
</UserControl>