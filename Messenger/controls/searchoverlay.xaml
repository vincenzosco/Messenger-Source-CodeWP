<Grid
    x:Class="Facebook.Messenger.WP8.Controls.SearchOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:vm="clr-namespace:Facebook.Messenger.WP8.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ContactSearchViewModel}">
    
    <Grid.Resources>
        <system:Double x:Key="VerticalOffset">-110</system:Double>
        <Storyboard x:Name="AnimateContactSearchIn">
            <DoubleAnimation Storyboard.TargetName="ContactSearch"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             Duration="0:0:0.25"
                             From="{StaticResource VerticalOffset}"
                             To="0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="AnimateContactSearchOut">
            <DoubleAnimation Storyboard.TargetName="ContactSearch"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             Duration="0:0:0.4"
                             From="0"
                             To="{StaticResource VerticalOffset}">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="ContactSearch"
            VerticalAlignment="Top"
            Background="White"
            Grid.Row="0"
            Margin="0,10,0,0"
            Height="100">

        <TextBox x:Name="SearchTextBox"
                  VerticalAlignment="Center"
                  Margin="15, 0"
                  Height="60"
                  Style="{StaticResource ContactSearchTextBoxStyle}"
                  TextChanged="ContactSearchFilterChanged"
                  GotFocus="SearchTextBox_OnGotFocus"
                  LostFocus="SearchTextBox_OnLostFocus"
                  IsEnabled="{Binding IsSearching}"/>

        <Border.RenderTransform>
            <TranslateTransform Y="-100" />
        </Border.RenderTransform>
    </Border>

    <Grid x:Name="SearchOverlayGrid"
          IsHitTestVisible="True"
          Grid.Row="1"
          Tap="OnOverlayGridTapped"
          Visibility="Collapsed"
          Background="#a0ffffff" />

    <Border Background="White" 
            Margin="0,-3,0,0"
            Grid.Row="1" 
            x:Name="SearchResultsBorder"
            Visibility="Collapsed">

        <base:FacebookListView x:Name="ContactsSearchResults"
                               ItemsSource="{Binding GroupAndContactSearchResults}"
                               GroupHeaderTemplate="{StaticResource ContactGroupHeaderTemplate}"
                               IsGroupingEnabled="True"
                               HideEmptyGroups="True"
                               Margin="20,0,0,0"
                               VerticalAlignment="Top">

            <base:FacebookListView.ItemTemplate>
                <DataTemplate>
                    <controls:SearchResultControl OnContactTapped="OnItemTapped"
                                                  OnGroupTapped="OnGroupItemTapped"/>
                </DataTemplate>
            </base:FacebookListView.ItemTemplate>
            <base:FacebookListView.ListFooter>
                <Border Background="White"
                        Height="6" />
            </base:FacebookListView.ListFooter>
        </base:FacebookListView>
    </Border>
    
    <TextBlock
        x:Name="EmptyStateTextBlock"
        Grid.Row="1"
        Visibility="Collapsed"
        TextAlignment="Center"
        Foreground="Black"
        Style="{StaticResource NuxTitleFontStyle}"
        Text="{Binding StringLibrary.Contact_Search_No_Results, Source={StaticResource LocalizedStrings}}"/>
    
    <controls:FBMessengerProgressBar 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                IsIndeterminate="{Binding IsLoading}"
                HorizontalAlignment="Center" 
                Width="400"
                VerticalAlignment="Top"
                Margin="0,-3,0,0"
                Height="10" />
    
</Grid>