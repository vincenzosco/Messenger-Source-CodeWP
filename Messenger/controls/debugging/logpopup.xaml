<UserControl x:Class="Facebook.Messenger.WP8.Controls.Debugging.LogPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}">
    
    <UserControl.Resources>
        <Storyboard
            x:Name="DisplayLogAnimation"
            TargetName="LogContainer"
            TargetProperty="Opacity"
            Completed="DisplayLogAnimation_OnCompleted">

            <DoubleAnimationUsingKeyFrames>

                <LinearDoubleKeyFrame
                    KeyTime="0:0:0.2"
                    Value="0.8" />

                <DiscreteDoubleKeyFrame
                    KeyTime="0:0:4"
                    Value="0.8" />

                <LinearDoubleKeyFrame
                    KeyTime="0:0:4.5"
                    Value="0.0" />

            </DoubleAnimationUsingKeyFrames>

        </Storyboard>
    </UserControl.Resources>
    
    <Grid
        x:Name="LogContainer"
        Background="Black"
        HorizontalAlignment="Center"
        Margin="30"
        Tap="LogContainer_OnTap"
        Opacity="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border
            x:Name="LogLevelBorder"
            Padding="5"
            Grid.Row="0"
            HorizontalAlignment="Stretch">

            <TextBlock
                x:Name="LogLevelText"
                Foreground="White"
                HorizontalAlignment="Center"/>

        </Border>
        
        <TextBlock
            x:Name="LogText"
            Padding="5"
            Grid.Row="1"
            FontSize="15"
            MaxHeight="150"
            Foreground="White"
            TextWrapping="Wrap"
            HorizontalAlignment="Center" />
        
    </Grid>

</UserControl>