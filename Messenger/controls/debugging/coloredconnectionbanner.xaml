<debugging:BaseConnectionBanner
    x:Class="Facebook.Messenger.WP8.Controls.Debugging.ColoredConnectionBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:debugging="clr-namespace:Facebook.Messenger.WP8.Controls.Debugging"
    mc:Ignorable="d">

    <UserControl.Resources>
        <system:Double x:Key="NetworkStatusBannerHeight">32</system:Double>
        <system:Double x:Key="NetworkStatusBannerHeightInverse">-32</system:Double>

        <Storyboard
            x:Name="ShowAnimation"
            TargetName="StatusDisplayTransform"
            TargetProperty="Y">

            <DoubleAnimationUsingKeyFrames>
                <DiscreteDoubleKeyFrame
                    KeyTime="0:0:0" 
                    Value="{StaticResource NetworkStatusBannerHeightInverse}" />

                <EasingDoubleKeyFrame 
                    KeyTime="0:0:0.25"
                    Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>

        <Storyboard
            x:Name="HideAnimation"
            TargetName="StatusDisplayTransform"
            TargetProperty="Y"
            Completed="OnBannerHidden">

            <DoubleAnimationUsingKeyFrames>
                <DiscreteDoubleKeyFrame
                    KeyTime="0:0:0" 
                    Value="0" />

                <DiscreteDoubleKeyFrame
                    KeyTime="0:0:4" 
                    Value="0" />
                
                <EasingDoubleKeyFrame 
                    KeyTime="0:0:4.25"
                    Value="{StaticResource NetworkStatusBannerHeightInverse}">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>

        <Storyboard
            x:Name="ShowAndHideAnimation"
            TargetName="StatusDisplayTransform"
            TargetProperty="Y"
            Completed="OnBannerHidden">

            <DoubleAnimationUsingKeyFrames>
                <DiscreteDoubleKeyFrame
                    KeyTime="0:0:0" 
                    Value="{StaticResource NetworkStatusBannerHeightInverse}" />

                <EasingDoubleKeyFrame 
                    KeyTime="0:0:0.25"
                    Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>

                <DiscreteDoubleKeyFrame
                    KeyTime="0:0:4" 
                    Value="0" />

                <EasingDoubleKeyFrame 
                    KeyTime="0:0:4.25"
                    Value="{StaticResource NetworkStatusBannerHeightInverse}">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>
    </UserControl.Resources>

    <Grid 
        x:Name="ConnectionStatusDisplay"
        Height="{StaticResource NetworkStatusBannerHeight}"
        VerticalAlignment="Top">
        
        <TextBlock
            x:Name="ConnectionStatusTextBlock"
            Grid.Column="0"
            FontSize="20"
            Foreground="{StaticResource MessengerWhiteBrush}"
            VerticalAlignment="Center"
            TextAlignment="Center"/>

        <Grid.RenderTransform>
            <TranslateTransform 
                x:Name="StatusDisplayTransform"
                Y="{StaticResource NetworkStatusBannerHeightInverse}"/>
        </Grid.RenderTransform>
    </Grid>
</debugging:BaseConnectionBanner>