<UserControl x:Class="Facebook.Messenger.WP8.Controls.Common.FullscreenProgressIndicatorWithButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">

    <Grid Background="{StaticResource MessengerWhiteBrush}">
        <StackPanel
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">

            <TextBlock
                x:Name="ProgressTextBlock"
                FontSize="{StaticResource PhoneFontSizeSmall}"
                HorizontalAlignment="Center"/>

            <ProgressBar
                x:Name="ProgressBar"
                Foreground="{StaticResource MessengerBlackBrush}"
                Height="10" />

            <Button
                x:Name="RetryButton"
                Style="{StaticResource BlueButtonStyle}"
                Content="{Binding StringLibrary.ButtonLabelRetry, Source={StaticResource LocalizedStrings}}"
                Width="200"
                Margin="140,50,140,0"
                Tap="Button_OnTap"/>
        </StackPanel>
    </Grid>
</UserControl>