<stickers:StickerPackViewModelControl 
    x:Class="Facebook.Messenger.WP8.Controls.Stickers.StickerSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:viewModels="clr-namespace:Facebook.Messenger.WP8.ViewModels"
    xmlns:stickers="clr-namespace:Facebook.Messenger.WP8.Controls.Stickers"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" 
    d:DesignWidth="480"
    d:DataContext="{d:DesignInstance viewModels:StickerPackViewModel}">

    <Grid Name="StickersContainer">
        <controls:FBMessengerProgressBar 
            IsIndeterminate="False"
            Name="StickerLoadingProgressBar"
            Visibility="Collapsed"
            VerticalAlignment="Top"/>
        <base:FacebookListView 
            x:Name="StickerList"
            LayoutMode="Grid" 
            GridCellSize="120, 110"
            Style="{StaticResource FloatingScrollbarStyle}"
            ItemsSource="{Binding Stickers}"
            Visibility="Collapsed">
            <base:FacebookListView.ItemTemplate>
                <DataTemplate>
                    <Image 
                        extensions:ImageCacheExtensions.ImageUri="{Binding ImageUri}"
                        Width="90" 
                        Height="90"
                        Tap="Sticker_OnTap"/>
                </DataTemplate>
            </base:FacebookListView.ItemTemplate>

        </base:FacebookListView>
        <Grid
            x:Name="StickerPackInfoGrid"
            Margin="20,20,20,15"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <Image 
                    Source="{Binding ThumbnailImage.Url}"
                    VerticalAlignment="Top"
                    Width="165"/>
                <Grid
                    x:Name="ProgressBarGrid"
                    Width="165"
                    Height="5"
                    Background="{StaticResource MessengerBorderGreyBrush}">
                    <controls:FBMessengerProgressBar 
                        Name="DownloadProgressBar"
                        IsIndeterminate="{Binding HasDownloadProgress, Converter={StaticResource InverseBoolConverter}}"
                        Minimum="0"
                        Margin="-12,0"
                        Maximum="100"
                        Value="{Binding DownloadProgress}"/>
                </Grid>
            </StackPanel>

            <Grid 
                Grid.Column="1" 
                Margin ="20, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock 
                    Text="{Binding Name}"
                    Grid.Row="0"
                    FontSize="22"
                    FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                    Foreground="{StaticResource MessengerTextBlackBrush}"/>
                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <TextBlock 
                            Text="{Binding DownloadError}"
                            Margin="0, 20, 0, 0"
                            TextAlignment="Left"
                            TextWrapping="Wrap"
                            FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                            Foreground="{StaticResource MessengerProgressRedBrush}"
                            Visibility="{Binding DownloadError, Converter={StaticResource StringLengthToVisibilityConverter}}"/>

                        <TextBlock 
                            Text="{Binding Description}"
                            Margin="0, 20, 0, 0"
                            TextAlignment="Left"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource MessengerTextLightGreyBrush}"
                            FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Button 
                x:Name="DownloadButton"
                Style="{StaticResource BlueButtonStyle}"
                Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0"
                IsEnabled="{Binding CanDownload}"
                Click="DownloadButton_OnClick">
                <TextBlock
                    x:Name="DownloadButtonTextBlock"
                    Text="{Binding DownloadStateText}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    TextTrimming="WordEllipsis"/>
            </Button>
        </Grid>
    </Grid>
</stickers:StickerPackViewModelControl>