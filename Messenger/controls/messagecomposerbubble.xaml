<UserControl x:Class="Facebook.Messenger.WP8.Controls.MessageComposerBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:messages="clr-namespace:Facebook.Messenger.WP8.Controls.Messages"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    GotFocus="MessageComposerBubble_OnGotFocus"
    d:DesignHeight="480"
    d:DesignWidth="480">

    <controls:BubbleContainer
        x:Name="BubbleContainer"
        Tap="BubbleTapped"
        TopNubVisibility="Collapsed"
        BottomNubVisibility="Visible"
        BottomNubOverlayVisibility="Visible"
        BubbleFill="White"
        HorizontalAlignment="Right"
        BubbleAlignment="Stretch"
        Margin="0,0,28,14"
        Width="333">
        
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <messages:ImageUploadAttachmentControl
                x:Name="UploadBar"
                Grid.Row="0" />

            <ScrollViewer Grid.Row="1"
                          MaxHeight="90"
                          Name="MessageComposeScrollViewer">
                <base:HintTextBox
                    TextWrapping="Wrap"
                    x:Name="ComposerTextBox"
                    AcceptsReturn="{Binding AllowMultipleLines}"
                    KeyDown="ComposerTextBox_OnKeyDown"
                    TextBoxTextChanged="OnTextBoxTextChanged"
                    InputScope="Text"
                    HintBorderThickness="0"
                    Margin="0,-5,0,0"
                    MinHeight="31"
                    TextBoxStyle="{StaticResource ComposerText}"
                    HintStyle="{StaticResource ComposerHintText}"
                    Hint="{Binding StringLibrary.Messages_Hint_Text, Source={StaticResource LocalizedStrings}}" 
                    GotFocus="ComposerTextBox_OnGotFocus"
                    LostFocus="ComposerTextBox_OnLostFocus"/>
            </ScrollViewer>
        </Grid>
    </controls:BubbleContainer>
</UserControl>