<controls:MessageListItemControl
    x:Class="Facebook.Messenger.WP8.Controls.MessageDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:ex="clr-namespace:Facebook.Messenger.WP8.Extensions"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    ex:TiltEffect.IsTiltEnabled="True"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">

    <Grid x:Name="RootGrid" 
          Margin="19, 5, 11, 0"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ProfilePhotoColumn"  Width="Auto" />
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
            <ColumnDefinition x:Name="RightProfilePhotoColumn"  Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SenderName"
                   Grid.Row="0"
                   Grid.Column="1"
                   Grid.ColumnSpan="3"
                   TextTrimming="WordEllipsis"
                   Foreground="{StaticResource MessengerTextLightGreyBrush}"
                   FontFamily="{StaticResource PhoneFontFamilyLight}"
                   FontSize="{StaticResource PhoneFontSizeSmall}"
                   VerticalAlignment="Center"
                   Text="{Binding Sender.Name}"/>

        <controls:UserTile
            x:Name="ProfilePhoto"
            Grid.Row="1"
            Grid.Column="0"
            Width="{StaticResource MessagesProfilePictureSize}"
            Height="{StaticResource MessagesProfilePictureSize}"
            Margin="3,0,9,0"
            VerticalAlignment="Bottom"
            IndicatorDiameter="20"
            DataContext="{Binding Sender}"/>

        <controls:MessageBubbleControl
            x:Name="Bubble"
            Grid.Row="1"
            Grid.Column="1"
            ShouldShowContextMenu="False"
            ViewMoreEvent="Bubble_OnViewMoreEvent"
            MessageActionEvent="Bubble_OnMessageActionEvent">
        </controls:MessageBubbleControl>

        <StackPanel x:Name="MessageDetailsStatusWrapper" 
            Grid.Column="1"
            Grid.Row="2">
            <TextBlock x:Name="TimeStampTextBlock"
                    Foreground="{StaticResource MessengerTextLightGreyBrush}"
                    FontSize="{StaticResource PhoneFontSizeSmall}"
                    TextAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding Timestamp, Converter={StaticResource MessageSentTimeTimestampConverter}}"/>
            <TextBlock x:Name="OriginTextBlock"
                    Foreground="{StaticResource MessengerTextLightGreyBrush}"
                    FontSize="{StaticResource PhoneFontSizeSmall}"
                    TextAlignment="Left"
                    VerticalAlignment="Center"/>
            <TextBlock Name="ReadReceiptLabel"
                   Margin="0, 10, 0, 0"
                   Text="{Binding StringLibrary.MessageDetails_Label_SeenBy, Source={StaticResource LocalizedStrings}}"
                   Foreground="{StaticResource MessengerTextLightGreyBrush}"
                   FontSize="{StaticResource PhoneFontSizeSmall}"
                   Visibility="Collapsed"/>
            <StackPanel x:Name="ReadReceiptDisplay"
                   VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</controls:MessageListItemControl>