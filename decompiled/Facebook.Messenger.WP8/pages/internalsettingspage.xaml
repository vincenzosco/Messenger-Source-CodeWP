<pages:InternalSettingsViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.InternalSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:internal="clr-namespace:Facebook.Messenger.WP8.Controls.Internal"
    xmlns:internal1="clr-namespace:Facebook.Messenger.WP8.ViewModels.Internal"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"  Orientation="Portrait"
    d:DataContext="{d:DesignInstance internal1:InternalSettingsViewModel}">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <phone:Pivot Title="{Binding InternalStringsLibrary.Internal_Settings_Title, Source={StaticResource LocalizedStrings}}">

            <phone:PivotItem Header="{Binding InternalStringsLibrary.Internal_Details_Settings_Title, Source={StaticResource LocalizedStrings}}">
                <internal:BuildDetails
                    DataContext="{Binding Path=BuildDetailsViewModel}"/>
            </phone:PivotItem>

            <phone:PivotItem Header="{Binding InternalStringsLibrary.Internal_Storage_Settings_Title, Source={StaticResource LocalizedStrings}}">
                <internal:DiskDetails
                    DataContext="{Binding Path=DiskDetailsViewModel}"/>
            </phone:PivotItem>
            
            <phone:PivotItem Header="{Binding InternalStringsLibrary.Internal_Audio_Settings_Title, Source={StaticResource LocalizedStrings}}">
                <internal:AudioLevels
                    DataContext="{Binding Path=AudioLevelsViewModel}" />
            </phone:PivotItem>

            <phone:PivotItem Header="{Binding InternalStringsLibrary.Internal_Network_Settings_Title, Source={StaticResource LocalizedStrings}}">
                <internal:NetworkDetails
                    DataContext="{Binding Path=NetworkInterfaceDetailsViewModel}" />
            </phone:PivotItem>

            <phone:PivotItem Header="{Binding InternalStringsLibrary.Internal_Sync_Protocol_Title, Source={StaticResource LocalizedStrings}}">
                <internal:SyncProtocol 
                    DataContext="{Binding Path=SyncProtocolSettingsViewModel}" />
            </phone:PivotItem>
        </phone:Pivot>
    </Grid>
    
</pages:InternalSettingsViewModelPage>