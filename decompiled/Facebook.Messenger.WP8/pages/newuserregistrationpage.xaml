<pages:NewUserRegistrationViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.NewUserRegistrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Background="{StaticResource MessengerWhiteBrush}"
    shell:SystemTray.IsVisible="False">

    <Grid>
        <Grid
            x:Name="RootGrid"
            Margin="24,45,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock 
            Grid.Row="0"
            Text="What's your name?"
            Foreground="{StaticResource MessengerBlackBrush}"
            FontSize="38"
            FontFamily="Segoe WP SemiLight"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            TextAlignment="Center"/>

            <TextBlock
            Grid.Row="1"
            Text="{Binding StringLibrary.Registration_Title2, Source={StaticResource LocalizedStrings}}"
            Foreground="{StaticResource PhonePageTextGrayBrush}"
            FontSize="20"
            TextWrapping="Wrap"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

            <Grid 
            Grid.Row="2"
            VerticalAlignment="Top"
            Margin="0,30,0,0"
            Name="FormContainer">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                Grid.Row="0"
                Margin="0,0,0,5"
                Foreground="{StaticResource MessengerTextLightGreyBrush}"
                Text="{Binding StringLibrary.Registration_TextboxHint_FirstName, Source={StaticResource LocalizedStrings}}"/>

                <TextBox x:Name="FirstNameTextBox"
                        Grid.Row="1"
                        Text="{Binding FirstName, Mode=TwoWay}"
                        Style="{StaticResource LoginTextBoxStyle2}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        InputScope="NameOrPhoneNumber"
                        TextChanged="OnTextChanged"
                         KeyUp="TextBox_OnKeyUp"/>

                <TextBlock
                Grid.Row="2"
                Margin="0,25,0,5"
                Foreground="{StaticResource MessengerTextLightGreyBrush}"
                Text="{Binding StringLibrary.Registration_TextboxHint_LastName, Source={StaticResource LocalizedStrings}}"/>

                <TextBox x:Name="LastNameTextBox"
                        Grid.Row="3"
                        Text="{Binding LastName, Mode=TwoWay}"
                        Style="{StaticResource LoginTextBoxStyle2}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        InputScope="NameOrPhoneNumber"
                        TextChanged="OnTextChanged"
                         KeyUp="TextBox_OnKeyUp"/>
            </Grid>
        </Grid>  
        <controls:FBMessengerProgressBar 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsIndeterminate="{Binding IsLoading}"
                    HorizontalAlignment="Center" 
                    Width="400"
                    Grid.Row="0" 
                    VerticalAlignment="Top"
                    Height="10" />
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar 
            Opacity="0.99"
             ForegroundColor="{StaticResource MessengerAppBarWhite}"
             BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>

</pages:NewUserRegistrationViewModelPage>