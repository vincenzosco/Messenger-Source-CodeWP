<pages:NameConversationViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.NameConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Loaded="NameConversationPage_OnLoaded">

    <pages:NameConversationViewModelPage.Resources>
        <Style x:Name="NoBorderButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </pages:NameConversationViewModelPage.Resources>

    <Grid x:Name="LayoutRoot" 
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Grid.RowSpan="2"
                Style="{StaticResource NoBorderButton}"
                Click="OnBackgroundClick">

        </Button>

        <controls:FBMessengerProgressBar 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsIndeterminate="{Binding IsLoading}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Height="10" />

        <TextBlock Grid.Row="0"
                   Margin="24,20"
                   Text="{Binding StringLibrary.NameConversation_Title, Source={StaticResource LocalizedStrings}}"
                   Foreground="{StaticResource MessengerBlackBrush}"
                   FontSize="22"
                   IsHitTestVisible="False"
                   FontWeight="Medium"/>
        
        <TextBox Grid.Row="1"
                 Margin="24,0"
                 VerticalAlignment="Top"
                 Name="ConversationNameTextBox"
                 KeyUp="ConversationNameTextBox_OnKeyUp"
                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                 TextChanged="ConversationNameTextBox_OnTextChanged"
                 Style="{StaticResource LoginTextBoxStyle2}"
                 InputScope="Text"
                 Text="{Binding ThreadName, Mode=TwoWay}"/>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar ForegroundColor="{StaticResource MessengerAppBarWhite}"
                              BackgroundColor="{StaticResource MessengerBlue}"/>
    </phone:PhoneApplicationPage.ApplicationBar>

</pages:NameConversationViewModelPage>