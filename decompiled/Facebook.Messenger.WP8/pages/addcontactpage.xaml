<pages:AddContactViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.AddContactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:extensions="clr-namespace:Facebook.Messenger.WP8.Extensions"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    Background="{StaticResource MessengerWhiteBrush}">

    <pages:AddContactViewModelPage.Resources>
        <phone:JumpListItemBackgroundConverter Enabled="{StaticResource MessengerBlueBrush}"
                                           Disabled="{StaticResource MessengerWhiteBrush}"
                                           x:Key="JumpListItemBackgroundConverter" />
        <phone:JumpListItemForegroundConverter Enabled="{StaticResource MessengerWhiteBrush}"
                                           Disabled="{StaticResource MessengerTransparentBlueBrush}"
                                           x:Key="JumpListItemForegroundConverter" />
        <Style x:Key="CountryCodeJumpListItemStyle"
               TargetType="phone:LongListSelector">
            <Setter Property="Background" 
                    Value="{StaticResource MessengerWhiteBrush}" />
            <Setter Property="Padding"
                    Value="0,0,0,0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="GridCellSize"
                    Value="115,115" />
            <Setter Property="LayoutMode"
                    Value="Grid" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource JumpListItemBackgroundConverter}}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                Margin="20,10,0,10">

                            <TextBlock Text="{Binding Key}"
                                FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                                FontSize="48"
                                Foreground="{Binding Converter={StaticResource JumpListItemForegroundConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountyCodeListHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PhoneFontFamilyNormal}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MessengerTextBlackBrush}"/>
        </Style>

        <DataTemplate x:Name="CountryCodeDataTemplate">
            <Grid Margin="2,0,0,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                       FontSize="36"
                       FontFamily="Segoe WP SemiLight"
                       Text="{Binding Path=CountryName}"
                       Foreground="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}"
                       TextWrapping="Wrap"
                       Tap="CountryCodeListItem_OnTap"/>
                <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       FontFamily="Segoe WP SemiLight"
                       FontSize="36"
                       Text="{Binding Path=PhonePrefixWithPlus}"
                       Foreground="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}"
                       TextAlignment="Right"
                       Tap="CountryCodeListItem_OnTap"/>
            </Grid>

        </DataTemplate>

        <DataTemplate x:Name="GroupedCountryCodeHeaderTemplate">
            <Grid Width="62"
                  Height="62"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,26">
                <Border Background="{StaticResource ListHeaderBackgroundGrayBrush}"
                        Height="62"
                        Width="62">
                    <TextBlock Text="{Binding Key}"
                           Foreground="Black"
                           FontSize="48"
                           Margin="8,0,0,2"
                           FontFamily="Segoe WP SemiLight"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" />
                </Border>

            </Grid>
        </DataTemplate>
    </pages:AddContactViewModelPage.Resources>
    
    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Margin="24">
        
        <Grid x:Name="AddContactGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Popup Name="CountryCodeListPopup"
                   IsOpen="False">
                <Grid Name="CountryCodeListGrid"
                      Background="{StaticResource MessengerWhiteBrush}"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                        Margin="20,46,20,0"
                        Style="{StaticResource CountyCodeListHeader}"
                        Text="{Binding StringLibrary.PhoneNumber_ListpickerLabel_CountryCode, Source={StaticResource LocalizedStrings}}"/>
                    <base:FacebookListView Name="CountryCodeList"
                        JumpListStyle="{StaticResource CountryCodeJumpListItemStyle}"
                        toolkit:TiltEffect.IsTiltEnabled="True"
                        Loaded="CountryCodeList_OnLoaded"
                        Margin="20, 20, 12, 0"
                        Grid.Row="1"
                        IsGroupingEnabled="True"
                        HideEmptyGroups="True"
                        ItemsSource="{Binding AlphaGroupedCountryCodes}"
                        ItemTemplate="{StaticResource CountryCodeDataTemplate}"
                        GroupHeaderTemplate="{StaticResource GroupedCountryCodeHeaderTemplate}"
                        SelectedItem="{Binding CountryCode}"/>
                </Grid>
            </Popup>

            <controls:FBMessengerProgressBar 
                x:Name="MessengerProgressBar"
                Grid.Row="0"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                IsIndeterminate="{Binding IsLoading}"
                HorizontalAlignment="Center" 
                VerticalAlignment="Top"
                Width="400"
                Height="10" />

            <Grid Background="{StaticResource MessengerWhiteBrush}"
                  Grid.Row="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                               Margin="0,32,0,0"
                               Text="{Binding StringLibrary.AddContact_PhoneNumber_Title, Source={StaticResource LocalizedStrings}}"
                               Foreground="{StaticResource MessengerBlackBrush}"
                               FontSize="22"
                               FontWeight="Medium" />

                <Grid Grid.Row="1"
                    VerticalAlignment="Top"
                    Name="PhoneFormContainer" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="35*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock 
                        Margin="0,24,0,0"
                        Grid.Row="0"
                        Text="{Binding StringLibrary.PhoneNumber_Select_Country, Source={StaticResource LocalizedStrings} }"
                        Foreground="{StaticResource PhonePageTextGrayBrush}" Grid.ColumnSpan="2"/>

                    <TextBox Name="CountryCodeListPicker"
                        Margin= "0,5,0,0"
                        Grid.Row="1"
                        IsHitTestVisible="False"
                        Style="{StaticResource LoginTextBoxStyle2}"
                        Text="{Binding ValidatedCountryCode.CountryName, Mode=OneWay}" Grid.ColumnSpan="2"/>

                    <Button Grid.Row="1"
                        Margin="0"
                        BorderThickness="0"
                        Opacity="0"
                        IsHitTestVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Background="Transparent"
                        Tap="CountryCodeListPicker_OnTap" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="2"
                        Text="{Binding StringLibrary.PhoneNumber_Box_Title, Source={StaticResource LocalizedStrings} }"
                        Foreground="{StaticResource PhonePageTextGrayBrush}" Grid.ColumnSpan="2"
                        Margin="0,18,0,0"/>

                    <Grid Grid.Row="3"
                        Margin="0,5,0,24" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            x:Name="PhonePrefixTextBox"
                            Margin="0,0,10,0"
                            Width="80"
                            Style="{StaticResource LoginTextBoxStyle2}"
                            Text="{Binding PrefixWithPlus}"
                            IsHitTestVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            LostFocus="PhonePrefixTextBoxOnLostFocus"
                            InputScope="TelephoneAreaCode"
                            MaxLength="4"/>
                        <TextBox
                            Grid.Column="1"
                            x:Name="PhoneNumberTextBox"
                            IsHitTestVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Text="{Binding MyPhoneNumber, Mode=TwoWay}"
                            Style="{StaticResource LoginTextBoxStyle2}"
                            KeyUp="PhoneNumberTextBox_KeyUp"
                            GotFocus="PhoneNumberForm_OnGotFocus"
                            LostFocus="PhoneNumberForm_OnLostFocus"
                            InputScope="TelephoneAreaCode"/>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2"
                    Text="{Binding StringLibrary.AddContact_PhoneNumber_Description, Source={StaticResource LocalizedStrings}}"
                    Foreground="{StaticResource MessengerButtonDarkGreyBrush}"
                    TextWrapping="Wrap"
                    FontSize="22"/>
            </Grid>
        </Grid>
        
        <Grid x:Name="MatchingUserFoundGrid"
              VerticalAlignment="Center"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Width="160" 
                  Height="160"
                  Margin ="0,0,0,40">

                <Image 
                    extensions:ImageCacheExtensions.ImageUri="{Binding Path=MatchingUser.Id, Converter={StaticResource ProfilePhotoConverter}, ConverterParameter=160}"
                    extensions:ImageCacheExtensions.PlaceholderUri="/Assets/Messages/Silhouette.png"
                    Stretch="UniformToFill"
                    extensions:RoundContentExtension.Radius="80"/>
                
                    <Image
                        Name="Logo"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,5,5"
                        Source="/Assets/Icons/added.png" 
                        Stretch="Uniform"
                        Width="44"
                        Height="44"/>
            </Grid>
            <RichTextBox
                Grid.Row="1"
                x:Name="UserAddedRichTextBox"
                Foreground="Black"
                TextAlignment="Center"
                FontSize="22"
                />
            
            <Button
                x:Name="SendMessageButton"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Style="{StaticResource BlueButtonStyle}"
                Margin="0,40"
                MinWidth="200"
                Click="SendMessageOnClick"/>
        </Grid>
        
        <Grid x:Name="InviteContactGrid"
              VerticalAlignment="Center"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Image 
                Source="/Assets/Icons/invitecontact.png"
                Height="160"
                Width="160"/>
            
            <RichTextBox
                x:Name="InviteUserRichTextBox"
                Grid.Row="1"
                Margin="0,40,0,0"
                Foreground="Black"
                TextAlignment="Center"
                FontSize="22"/>
            
            <Button
                Grid.Row="2"
                HorizontalAlignment="Center"
                Content="{Binding StringLibrary.AddContact_Invite_Button, Source={StaticResource LocalizedStrings}}"
                Style="{StaticResource BlueButtonStyle}"
                Margin="0,40"
                MinWidth="160"
                Click="InviteOnClick"/>
        </Grid>
    </Grid>


    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar 
            Opacity="0.99"
             ForegroundColor="{StaticResource MessengerAppBarWhite}"
             BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>

</pages:AddContactViewModelPage>