<pages:MainViewModelPage
    x:Class="Facebook.Messenger.WP8.Pages.MessengerMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Facebook.Messenger.WP8.Pages"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:vm="clr-namespace:Facebook.Messenger.WP8.ViewModels"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"  
    Orientation="Portrait"
    d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Background="White">

        <phone:Panorama
            x:Name="MainPanorama"
            Padding="0"
            Margin="0"
            SelectionChanged="MainPanorama_OnSelectionChanged"
            Loaded="MainPanorama_OnLoaded">

            <phone:Panorama.Title>
                <Canvas />
            </phone:Panorama.Title>

            <phone:PanoramaItem
                x:Name="RecentPanorama"
                Style="{StaticResource MessengerPanoramaItemStyle}"
                Margin="0,4,0,0"
                Header="{Binding StringLibrary.MainPage_Pivot_Title_Recent_Threads, Source={StaticResource LocalizedStrings}}">
                <controls:RecentThreadsUserControl 
                    DataContext="{Binding Path=Threads}" />
            </phone:PanoramaItem>

            <phone:PanoramaItem
                x:Name="GroupsPanorama"
                Style="{StaticResource MessengerPanoramaItemStyle}"
                Canvas.ZIndex="1"
                Header="{Binding StringLibrary.MainPage_Pivot_Title_Groups, Source={StaticResource LocalizedStrings}}"/>

            <phone:PanoramaItem
                x:Name="FriendsPanorama"
                Margin="0,4,0,0"
                Style="{StaticResource MessengerPanoramaItemStyle}"
                Header="{Binding StringLibrary.MainPage_Pivot_Title_Friends, Source={StaticResource LocalizedStrings}}"/>

            <phone:PanoramaItem
                x:Name="ActivePanorama"
                Margin="0,4,0,0"
                Style="{StaticResource MessengerPanoramaItemStyle}"
                Visibility="{Binding IsPartialUser, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1}"
                Header="{Binding StringLibrary.MainPage_Pivot_Title_Active, Source={StaticResource LocalizedStrings}}"/>            
        </phone:Panorama>

    </Grid>
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar ForegroundColor="{StaticResource MessengerAppBarWhite}"
                              BackgroundColor="{StaticResource MessengerBlue}" />
    </phone:PhoneApplicationPage.ApplicationBar>
</pages:MainViewModelPage>
