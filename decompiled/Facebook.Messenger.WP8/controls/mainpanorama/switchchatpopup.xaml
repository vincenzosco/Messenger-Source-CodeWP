<controls:FacebookPopup x:Class="Facebook.Messenger.WP8.Controls.MainPanorama.SwitchChatPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    d:DesignHeight="480" d:DesignWidth="480">

    <controls:FacebookPopup.Resources>
        <Style x:Key="SwitchActiveHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PhoneFontFamilyNormal}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MessengerTextBlackBrush}"/>
        </Style>        
    </controls:FacebookPopup.Resources>
    
    <Grid Background="{StaticResource PopupGrayBrush}" 
          Name="SwitchChatPopupGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                           Margin="20,46,20,0"
                           Style="{StaticResource SwitchActiveHeader}"
                           Text="{Binding StringLibrary.MainPage_Active_Chat_Popup, Source={StaticResource LocalizedStrings}}"/>
        <TextBlock
                    Grid.Row="1"
                    Text="{Binding StringLibrary.MainPage_Active_Enable_Chat, Source={StaticResource LocalizedStrings}}"
                    Visibility="{Binding ActiveUsers.IsChatEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1}"
                    Margin="20,40,0,0"
                    FontSize="37"
                    FontFamily="Segoe WP SemiLight"
                    Tap="EnableChatTapped" />
        <TextBlock
                    Grid.Row="1"
                    Text="{Binding StringLibrary.MainPage_Active_Disable_Chat, Source={StaticResource LocalizedStrings}}"
                    Visibility="{Binding ActiveUsers.IsChatEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="20,40,0,0"
                    FontSize="37"
                    FontFamily="Segoe WP SemiLight"
                    Tap="DisableChatTapped" />
    </Grid>
</controls:FacebookPopup>