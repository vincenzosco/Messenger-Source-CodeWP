<fb:BaseControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:command="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Platform"
    xmlns:fb="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    x:Class="Facebook.Messenger.WP8.Controls.RecentThreadsUserControl"
    xmlns:vm="clr-namespace:Facebook.Messenger.WP8.ViewModels"
    d:DataContext="{d:DesignInstance vm:ThreadsViewModel}"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="NavigateEvent">
            <command:EventToCommand
                Command="{Binding NavigateCommand}"
                PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="LayoutRoot">
        <fb:FacebookListView
            Style="{StaticResource FloatingScrollbarStyle}"
            x:Name="ThreadList"
            ItemsSource="{Binding Threads}">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="ListEvent">
                    <command:EventToCommand Command="{Binding ListEventCommand}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <fb:FacebookListView.ItemTemplate>
                <DataTemplate>
                    <controls:ThreadControl
                        Tap="OnItemTapped">
                        <toolkit:ContextMenuService.ContextMenu>                                                        
                            <toolkit:ContextMenu
                                Unloaded="ContextMenu_OnUnloaded"
                                Style="{StaticResource ContextMenuStyle}">
                                
                                <toolkit:MenuItem 
                                    Header="{Binding StringLibrary.MainPage_AppBar_Mute_Button, Source={StaticResource LocalizedStrings}}"
                                    Foreground="White" 
                                    Click="Mute_OnClicked"
                                    Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1 }"/>

                                <toolkit:MenuItem
                                    Header="{Binding StringLibrary.UnMute_Conversation_Menu_Item, Source={StaticResource LocalizedStrings}}"  
                                    Foreground="White" 
                                    Click="UnMute_OnClicked"
                                    Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <toolkit:MenuItem 
                                    Header="{Binding StringLibrary.Recent_ContextMenu_Archive, Source={StaticResource LocalizedStrings}}" 
                                    Click="ArchiveThread_OnClick"/>

                                <toolkit:MenuItem 
                                    Header="{Binding StringLibrary.Recent_ContextMenu_Leave, Source={StaticResource LocalizedStrings}}" 
                                    Click="LeaveThread_OnClick"
                                    Visibility="{Binding CanLeaveConversation, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                
                                <toolkit:MenuItem 
                                    Header="{Binding StringLibrary.Recent_ContextMenu_Spam, Source={StaticResource LocalizedStrings}}" 
                                    Click="SpamThread_OnClick"/>

                                <toolkit:MenuItem 
                                    Header="{Binding StringLibrary.Recent_ContextMenu_Delete, Source={StaticResource LocalizedStrings}}" 
                                    Click="DeleteThread_OnClick"/>
                                
                                <toolkit:MenuItem
                                    Header="{Binding StringLibrary.Recent_ContextMenu_MarkUnread, Source={StaticResource LocalizedStrings}}"
                                    Click="OnMarkUnreadClicked"
                                    Visibility="{Binding Unread, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1}"/>
                                    
                            </toolkit:ContextMenu>
                        </toolkit:ContextMenuService.ContextMenu>
                    </controls:ThreadControl>
                </DataTemplate>
            </fb:FacebookListView.ItemTemplate>

            <fb:FacebookListView.ListFooter>
                <Grid Height="30"> 
                    <controls:FBMessengerProgressBar
                        VerticalAlignment="Top"
                        IsIndeterminate="{Binding FetchingThreads}"
                        Visibility="{Binding FetchingThreads, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </fb:FacebookListView.ListFooter>

            <!-- We need to keep an non-empty list header so the view remains "sticky" to the top when receiving a message. -->
            <fb:FacebookListView.ListHeader>
                <Grid />
            </fb:FacebookListView.ListHeader>

        </fb:FacebookListView>

        <TextBlock x:Name="EmptyTextBlock"
                   Text="{Binding EmptyText}"
                   Margin="0,24,0,0"
                   Visibility="{Binding EmptyText, Converter={StaticResource StringLengthToVisibilityConverter}}"
                   TextAlignment="Left"
                   TextWrapping="Wrap"
                   Style="{StaticResource NuxTitleFontStyle}"/>
    </Grid>
</fb:BaseControl>
