<base:BaseControl x:Class="Facebook.Messenger.WP8.Controls.VideoAttachmentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">
    
    <Grid x:Name="LayoutRoot" Tap="PreviewImage_OnTap">
        <Grid x:Name="PreviewImageContainer"/>
        
        <Grid x:Name ="MediaElementContainer"/>
        <Grid x:Name="SizeGrid">
            <Canvas x:Name="MediaCanvas">
                <Canvas.Background>
                    <VideoBrush x:Name="VideoBrush"/>
                </Canvas.Background>
            </Canvas>
            
            <controls:ImageButton x:Name="PlayButton"
                Height="84"
                Width="84"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource TiltingImageButton}"
                BackgroundSource="\Assets\Camera\ViewfinderButtonBackground.png"
                Source="\Assets\Camera\PlayButton.png"/>
             
            <TextBlock x:Name="DurationTextBlock"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="10"
                       Foreground ="{StaticResource MessengerWhiteBrush}"/>

            <ProgressBar
                x:Name="ProgressBar"
                Foreground="{StaticResource MessengerWhiteBrush}"
                IsIndeterminate="False"
                Visibility="Collapsed"
                Width="84"
                Height="84"
                Style="{StaticResource UploadProgressRingStyle}"/>

        </Grid>
    </Grid>

</base:BaseControl>