<controls:ComposerDrawer x:Class="Facebook.Messenger.WP8.Controls.GalleryDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}">

    <Grid Background="{StaticResource MessengerBackgroundGreyBrush}"
          Width="480"
          Height="484"
          VerticalAlignment="Center"
          HorizontalAlignment="Center">
        
        <controls:ImageDrawer
            x:Name="GalleryImageDrawer"
            EmptyListText="{Binding StringLibrary.MessageComposer_EmptyGallery_Text, Source={StaticResource LocalizedStrings}}"
            SendClicked="GalleryImageDrawer_OnSendClicked"
            EditClicked="GalleryImageDrawer_OnEditClicked"/>

        <controls:CircledIcon 
            Margin="13,84,13,13"
            x:Name="ImageChooser"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Tap="GalleryButton_Tap"
            Style="{StaticResource TiltingImageButton}"
            BackgroundSource="\Assets\AppBar\BaseCircleShaded.png"
            Source="\Assets\Camera\Gallery.png"
            SelectedSource="\Assets\Camera\GallerySelected.png"/>
        
    </Grid>

</controls:ComposerDrawer>
