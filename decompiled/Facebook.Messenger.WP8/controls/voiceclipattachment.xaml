<UserControl x:Class="Facebook.Messenger.WP8.Controls.VoiceClipAttachment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="51" d:DesignWidth="480">
    
    <StackPanel x:Name="LayoutRoot"
                Orientation="Horizontal">

        <Button
            Style="{StaticResource ButtonStyle}"
            Background="Transparent"
            Tap="PlayPauseButton_OnTap"
            Padding="16"
            Width="60">

            <Grid>
                <Viewbox>
                    <Path x:Name="PauseButton" Visibility="Collapsed" Data="M0,0L0,5L1,5L1,0M3,0L3,5L4,5L4,0z" Fill="White"/>
                </Viewbox>
                <Viewbox>
                    <Path x:Name="PlayButton" Visibility="Visible" Fill="White" Data="M0,0L1,0.5L0,1z"/>
                </Viewbox>
            </Grid>
        </Button>
        
        <ProgressBar
            x:Name="VoiceClipProgressBar"
            Style="{StaticResource AudioProgressBarStyle}"
            Padding="0, 0, 10, 0"
            Margin="-5,0,0,0"
            Maximum="1"/>

        <TextBlock
            x:Name="ProgressText"
            Text="{Binding Path=Position, ElementName=VoiceClipMedia}"
            Foreground="White"
            TextAlignment="Right"
            VerticalAlignment="Center"
            FontSize="{StaticResource PhoneFontSizeSmall}"
            FontWeight="ExtraLight"
            Width="45"
            Margin="0,0,13,0"/>
    </StackPanel>
</UserControl>