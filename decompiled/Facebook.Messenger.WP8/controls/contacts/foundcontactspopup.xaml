<controls:FacebookPopup x:Class="Facebook.Messenger.WP8.Controls.Contacts.FoundContactsPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:contacts="clr-namespace:Facebook.Messenger.WP8.Controls.Contacts"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">

    <Grid 
        x:Name="FoundContactPopupControl" 
        Background="{StaticResource MessengerWhiteBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock 
            x:Name="FoundContactsHeader"
            Foreground="{StaticResource MessengerBlackBrush}"
            TextWrapping="Wrap"
            FontSize="22"
            IsHitTestVisible="False"
            FontWeight="Medium"
            Margin="20, 50, 20, 20"/>
        <base:FacebookListView 
            x:Name="FoundContactsList"
            Grid.Row="1"
            Margin="20, 10, 20, 0">
            <base:FacebookListView.ItemTemplate>
                <DataTemplate>
                    <contacts:ContactPhoneUserControl
                        NameFontSize="{StaticResource PhoneFontSizeLarge}"
                        ImageSize="62"
                        Tap="Contact_OnTap"
                        ContactCardTap="Contact_OnContactCardTap"/>
                </DataTemplate>
            </base:FacebookListView.ItemTemplate>
        </base:FacebookListView>
    </Grid>
</controls:FacebookPopup>