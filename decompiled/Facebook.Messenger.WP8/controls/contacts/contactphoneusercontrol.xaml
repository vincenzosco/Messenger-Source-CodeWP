<controls:ContactListItemControl x:Class="Facebook.Messenger.WP8.Controls.Contacts.ContactPhoneUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:models="clr-namespace:Facebook.Models;assembly=Facebook-Models"
    d:DataContext="{d:DesignInstance models:FacebookUser}"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:pixelLab="clr-namespace:PixelLab"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">
    
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <controls:UserTile
                Margin="0,2,5,2"
                x:Name="ImageUserTile"
                Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Height="80"
                Width="80"
                IndicatorDiameter="20"/>
            <pixelLab:DynamicTextBlock
                Style="{StaticResource ActiveUserDynamicTextBlockStyle}"
                Margin="10,4,10,0"
                x:Name="NameTextBlock"
                Grid.Column="1"
                Grid.Row="0"
                Text="{Binding Name}"
                VerticalAlignment="Center"/>
            <TextBlock 
                x:Name="PhoneNumberTextBlock"
                Grid.Column="1"
                Grid.Row="1"
                Margin="10,0"
                Foreground="{StaticResource PhonePageTextGrayBrush}"/>
            <Grid 
                Grid.Column="2"
                Grid.RowSpan="2"
                VerticalAlignment="Stretch"
                Tap="ContactCard_OnTap"
                Background="Transparent">
                <Image 
                    Source="/Assets/Contacts/PhoneContact.png" 
                    Visibility="{Binding IsPhoneOnlyContact, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</controls:ContactListItemControl>