<UserControl x:Class="Facebook.Messenger.WP8.Controls.ContactListUserControl"
             x:Name="ContactListUserControlRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
             xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:command="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Platform"
             xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
             mc:Ignorable="d"
             FontFamily="{StaticResource PhoneFontFamilyNormal}"
             FontSize="{StaticResource PhoneFontSizeNormal}"
             Foreground="{StaticResource PhoneForegroundBrush}"
             d:DesignHeight="480"
             d:DesignWidth="480">

    <UserControl.Resources>

        <phone:JumpListItemBackgroundConverter 
            Enabled="{StaticResource MessengerBlueBrush}"
            Disabled="{StaticResource MessengerWhiteBrush}"
            x:Key="BackgroundConverter" />
        
        <phone:JumpListItemForegroundConverter 
            Enabled="{StaticResource MessengerWhiteBrush}"
            Disabled="{StaticResource MessengerTransparentBlueBrush}"
            x:Key="ForegroundConverter" />
        
        <Style 
            x:Key="ContactJumpListItemStyle"
            TargetType="phone:LongListSelector">
            <Setter 
                Property="Background" 
                Value="{StaticResource MessengerWhiteBrush}" />
            <Setter 
                Property="Padding"
                Value="0,0,0,0" />
            <Setter 
                Property="HorizontalContentAlignment"
                Value="Center" />
            <Setter 
                Property="GridCellSize"
                Value="115,115" />
            <Setter 
                Property="LayoutMode"
                Value="Grid" />
            <Setter 
                Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border 
                            Background="{Binding Converter={StaticResource BackgroundConverter}}"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="20,10,0,10"
                            CornerRadius="60">

                        <TextBlock 
                            Text="{Binding Key}"
                            FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                            FontSize="48"
                            Foreground="{Binding Converter={StaticResource ForegroundConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <DataTemplate 
            x:Key="ContactsGroupHeaderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle 
                    Width="67.5"
                    Visibility="{Binding Path=AllowMultipleSelection, ElementName=ContactListUserControlRoot, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Grid 
                    Grid.Column="1"
                    Width="62"
                    Height="62"
                    HorizontalAlignment="Left"
                    Margin="0,6"
                    Background="Transparent">

                <TextBlock Text="{Binding Key}"
                    Foreground="Black"
                    FontSize="36"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <Border 
                    BorderBrush="Black"
                    BorderThickness="3"
                    CornerRadius="31"
                    Height="62"
                    Width="62"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger 
            EventName="NavigateEvent">
            <command:EventToCommand 
                Command="{Binding NavigateCommand}"
                PassEventArgsToCommand="True" />
        </i:EventTrigger>
        <i:EventTrigger 
            EventName="UserSelectedEvent">
            <command:EventToCommand 
                Command="{Binding UserSelectedCommand}"
                PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid 
        x:Name="LayoutRoot">
        <base:FacebookListView 
            x:Name="ContactsList"
            IsGroupingEnabled="{Binding ShouldGroupContacts}"
            HideEmptyGroups="True"
            GroupHeaderTemplate="{StaticResource ContactsGroupHeaderTemplate}"
            JumpListStyle="{StaticResource ContactJumpListItemStyle}"
            Visibility="{Binding EmptyText, Converter={StaticResource StringLengthToVisibilityConverter}, ConverterParameter=1}">
            <base:FacebookListView.ListHeader>
                <Grid
                    x:Name="ContactSyncPromoGrid"
                    Visibility="{Binding ContactSyncFeatureEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button 
                        Margin="0,14,0,28"
                        Grid.Column="0"
                        Visibility="{Binding ContactSyncStatusText, Converter={StaticResource StringLengthToVisibilityConverter}}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BareTiltButton}"
                        Click="FindContacts_OnClick"
                        MaxWidth="300">
                    <TextBlock 
                        Text="{Binding ContactSyncStatusText}"
                        HorizontalAlignment="Left"
                        FontFamily="Segoe WP SemiLight"
                        FontSize="32"
                        TextWrapping="Wrap"/>
                    </Button>
                    <Button 
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Margin="10,28"
                        HorizontalAlignment="Left"
                        Visibility="{Binding ShowAllNewContactsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource BareTiltButton}"
                        Click="ShowAllFoundContacts_OnClick"
                        MaxWidth="100">
                    <TextBlock 
                        Text="{Binding StringLibrary.ContactList_Header_ShowAll, Source={StaticResource LocalizedStrings}}"
                        HorizontalAlignment="Left"
                        FontSize="20"
                        FontFamily="Segoe WP SemiLight"
                        Foreground="{StaticResource MessengerBlueBrush}"
                        TextWrapping="Wrap"/>
                    </Button>
                </Grid>
            </base:FacebookListView.ListHeader>
            <base:FacebookListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle
                            Visibility="{Binding Path=AllowMultipleSelection, ElementName=ContactListUserControlRoot, Converter={StaticResource BoolToVisibilityConverter}}"
                            Width="67.5"/>
                        <CheckBox   
                            IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                            Style="{StaticResource GroupSelectionCheckBoxStyle}" 
                            Visibility="{Binding Path=AllowMultipleSelection, ElementName=ContactListUserControlRoot, Converter={StaticResource BoolToVisibilityConverter}}"
                            Checked="ToggleButton_OnCheckChanged"
                            Unchecked="ToggleButton_OnCheckChanged"/>
                        <controls:ContactUserControl
                            Grid.Column="1"
                            NameFontSize="{StaticResource PhoneFontSizeLarge}"
                            ImageSize="62"
                            Tap="OnItemTapped"
                            ContactCardTap="ContactUserControl_OnContactCardTap"
                            AllowSelection="{Binding ElementName=ContactListUserControlRoot, Path=AllowMultipleSelection}"/>
                    </Grid>
                </DataTemplate>
            </base:FacebookListView.ItemTemplate>
        </base:FacebookListView>
        <Grid x:Name="PartialUserNux">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="NuxTextBlock"
                Margin="0,24,0,0"
                Text="{Binding EmptyText}"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Style="{StaticResource NuxTitleFontStyle}"
                Visibility="{Binding EmptyText, Converter={StaticResource StringLengthToVisibilityConverter}}"/>
            
            <Button
                x:Name="NuxEmptyStateButton"
                Grid.Row="1"
                Margin="0,40"
                Style="{StaticResource BareTiltButton}"
                HorizontalAlignment="Left"
                Content="{Binding EmptyActionButtonLabel}"
                Visibility="{Binding EmptyActionButtonLabel, Converter={StaticResource StringLengthToVisibilityConverter}}"
                Foreground="Black"
                FontSize="36"
                FontWeight="Light"
                Click="NuxEmptyStateButton_OnClick"
                />
        </Grid>
    </Grid>
</UserControl>