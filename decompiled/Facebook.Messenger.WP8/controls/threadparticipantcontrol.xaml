<controls:ThreadListItemControl
    x:Class="Facebook.Messenger.WP8.Controls.ThreadParticipantControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:pixelLab="clr-namespace:PixelLab"
    mc:Ignorable="d"
    xmlns:ex="clr-namespace:Facebook.Messenger.WP8.Extensions"
    xmlns:viewModels="clr-namespace:Facebook.Messenger.WP8.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:ThreadViewModel}"
    ex:TiltEffect.IsTiltEnabled="True"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    MinHeight="84"
    d:DesignHeight="100" d:DesignWidth="480">
    
    <Grid x:Name="LayoutRoot" 
          Background="Transparent">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <controls:FaceMash
            x:Name="FaceMash"
            Height="68"
            Width="68"
            HorizontalAlignment="Right"/>

        <controls:ProfileIndicatorControl
            x:Name="IndicatorControl"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Height="25"
            Width="25"
            Margin="0,0,0,7"
            ImageBorderThickness="3" />

        <Grid Grid.Column="1" Margin="10,0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <pixelLab:DynamicTextBlock 
                x:Name="ThreadTitle"
                Style="{StaticResource ActiveUserDynamicTextBlockStyle}"
                Foreground="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}"
                Grid.Row="0"
                Margin="0,0,20,0"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Text="Text" />

            <pixelLab:DynamicTextBlock
                x:Name="ThreadParticipants"
                Style="{StaticResource ActiveUserDynamicTextBlockStyle}"
                Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringLengthToVisibilityConverter}}"
                Foreground="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}"
                Grid.Row="1"
                FontSize="18"
                VerticalAlignment="Bottom"
                Margin="0,5,20,15"/>
        </Grid>
        
        <Grid Grid.Column="2" 
              VerticalAlignment="Center"
              HorizontalAlignment="Right">
            <Image Source ="/Assets/Generic/BlueCheck.png"
                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

    </Grid>
</controls:ThreadListItemControl>
