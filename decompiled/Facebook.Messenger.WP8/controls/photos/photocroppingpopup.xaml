<controls:FacebookPopup
    x:Class="Facebook.Messenger.WP8.Controls.Photos.PhotoCroppingPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    x:Name="PhotoCroppingPopupRoot">

    <controls:FacebookPopup.Resources>
        <Storyboard
            x:Name="SendAnimation"
            Completed="SendAnimation_OnCompleted">

            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Overlay"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame
                    Value="0.5"
                    KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame
                    Value="1"
                    KeyTime="0:0:0.75"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="ContentPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <LinearDoubleKeyFrame
                    Value="0"
                    KeyTime="0:0:0.75"/>
                <EasingDoubleKeyFrame
                    Value="600"
                    KeyTime="0:0:1.25">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>
    </controls:FacebookPopup.Resources>

    <Grid Background="{StaticResource MessengerWhiteBrush}">
        <Grid
            x:Name="ContentPanel"
            Background="{StaticResource MessengerWhiteBrush}">
                
            <Grid.RenderTransform>
                <CompositeTransform/>
            </Grid.RenderTransform>
            
            <ViewportControl
                x:Name="viewport"
                VerticalContentAlignment="Top"
                HorizontalContentAlignment="Left"
                ManipulationStarted="OnManipulationStarted"
                ManipulationDelta="OnManipulationDelta"
                ManipulationCompleted="OnManipulationCompleted"
                ViewportChanged="viewport_ViewportChanged"
                ManipulationStateChanged="Viewport_OnManipulationStateChanged">
                <Canvas x:Name="canvas">
                    <Image
                        x:Name="Photo"
                        Stretch="Fill"
                        RenderTransformOrigin="0,0"
                        CacheMode="BitmapCache">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="xform"/>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </ViewportControl>

            <Grid
                Name="Overlay"
                Opacity="0.5"
                IsHitTestVisible="False">
                <Grid.Background>
                    <RadialGradientBrush
                        x:Name="RadialBrush"
                        MappingMode="Absolute"
                        RadiusX="200"
                        RadiusY="200">
                        <RadialGradientBrush.GradientStops>
                            <GradientStop
                                Offset="0"
                                Color="Transparent"/>
                            <GradientStop
                                Offset="0.99"
                                Color="Transparent"/>
                            <GradientStop
                                Offset="0.99"
                                Color="{StaticResource MessengerBlack}"/>
                            <GradientStop
                                Offset="1"
                                Color="{StaticResource MessengerBlack}"/>
                            <GradientStop
                                Offset="1"
                                Color="{StaticResource MessengerWhite}"/>
                        </RadialGradientBrush.GradientStops>
                    </RadialGradientBrush>
                </Grid.Background>
            </Grid>

            <controls:FBMessengerProgressBar
                x:Name="MessengerProgressBar"
                Visibility="Collapsed"
                VerticalAlignment="Top"
                IsIndeterminate="False" />
                
        </Grid>
        <Grid
            x:Name="CustomApplicationBar"
            Background="{StaticResource MessengerBlueBrush}"
            VerticalAlignment="Bottom"
            Height="{StaticResource AppBarHeight}">
            <controls:CircledIcon
                Source="/Assets/AppBar/Check.png"
                HorizontalAlignment="Center"
                Tap="CropPhotoButton_OnTap"
                Style="{StaticResource TiltingImageButton}"/>
        </Grid>
    </Grid>
</controls:FacebookPopup>