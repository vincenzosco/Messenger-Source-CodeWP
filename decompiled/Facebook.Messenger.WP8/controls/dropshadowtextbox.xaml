<UserControl
    x:Class="Facebook.Messenger.WP8.Controls.DropShadowTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="480"
    d:DesignWidth="480">
    
    <UserControl.Resources>
        <Style x:Key="BasicTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ContentControl
                                x:Name="ContentElement"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                Padding="{TemplateBinding Padding}"
                                VerticalContentAlignment="Stretch"
                                Content=""/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <SolidColorBrush
            x:Key="DropShadowColorBrush"
            Color="Black"
            Opacity="0.5"/>
    </UserControl.Resources>
    
    <Grid x:Name="LayoutRoot"
          Background="Transparent">
        <TextBox
            x:Name="ShadowTextBox"
            Style="{StaticResource BasicTextBoxStyle}"
            IsHitTestVisible="False"
            IsTabStop="False"
            IsEnabled="False"
            Foreground="{StaticResource DropShadowColorBrush}"
            TextAlignment="{Binding TextAlignment}"
            TextWrapping="{Binding TextWrapping}">
            <TextBox.RenderTransform>
                <TranslateTransform Y="1"/>
            </TextBox.RenderTransform>
        </TextBox>
        <TextBox
            x:Name="InputTextBox"
            Style="{StaticResource BasicTextBoxStyle}"
            TextAlignment="{Binding TextAlignment}"
            TextWrapping="{Binding TextWrapping}"
            GotFocus="InputTextBox_OnGotFocus"
            LostFocus="InputTextBox_OnLostFocus"
            TextChanged="InputTextBox_OnTextChanged"/>
    </Grid>
</UserControl>