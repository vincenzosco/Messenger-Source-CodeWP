<base:BaseControl xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
                  xmlns:controls="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:Class="Facebook.Messenger.WP8.Controls.Common.StickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:img="clr-namespace:ImageTools.Controls"
    mc:Ignorable="d">

    <img:AnimatedImage x:Name="StickerImage" 
                       AnimationMode="Repeat"
                       RepeatCount="4"
                       Tap="StickerImage_OnTap">
        <img:AnimatedImage.Template>
            <ControlTemplate>
                <Image x:Name="Image" 
                       HorizontalAlignment="Left"
                       Stretch="Uniform"/>
            </ControlTemplate>
        </img:AnimatedImage.Template>
    </img:AnimatedImage>    
</base:BaseControl>