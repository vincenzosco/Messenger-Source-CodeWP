<base:BaseControl
    x:Class="Facebook.Messenger.WP8.Controls.FaceMash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:viewModels="clr-namespace:Facebook.Messenger.WP8.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{viewModels:ThreadViewModel}"
    d:DesignHeight="50"
    d:DesignWidth="50">
    
    <Grid x:Name="FaceMashGrid">
        <Grid.Clip>
            <EllipseGeometry x:Name="ClipGeometry"/>
        </Grid.Clip>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="Column"/>
        </Grid.ColumnDefinitions>
        <Image
            x:Name="First"
            HorizontalAlignment="Center"
            Stretch="UniformToFill"
            Grid.Column="0"/>

        <Grid Grid.Column="1"
              Margin="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image
                x:Name="Second"
                HorizontalAlignment="Center"
                Grid.Row="0"
                Margin="0,0,0,0.5"
                Stretch="UniformToFill"/>

            <Image
                x:Name="Third"
                HorizontalAlignment="Center"
                Grid.Row="1"
                Margin="0,0.5,0,0"
                Stretch="UniformToFill"/>
        </Grid>
    </Grid>
</base:BaseControl>
