<UserControl x:Class="Facebook.Messenger.WP8.Controls.AdminMessageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">
    
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <TextBlock 
            x:Name="AdminMessageBlock"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Margin="20,0,0,0"
            Style="{StaticResource AdminMessageStyle}"/>

        <Border 
            x:Name="AdminImageBlock"
            Grid.Row="1"
            BorderThickness="1"
            Background="Transparent"
            BorderBrush="{StaticResource MessengerTextDarkGreyBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Tap="AdminImageBlock_OnTap">

            <Image 
                x:Name="AdminImage"
                HorizontalAlignment="Center"
                Stretch="UniformToFill"
                Margin="3"
                Width="100"
                Height="100"/>
        </Border>
    </Grid>
</UserControl>