<UserControl x:Class="Facebook.Messenger.WP8.Controls.Internal.DiskDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:internal="clr-namespace:Facebook.Messenger.WP8.ViewModels.Internal"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DataContext="{d:DesignInstance internal:DiskDetailsViewModel}"
    d:DesignHeight="480" d:DesignWidth="480">

    <ListBox ItemsSource="{Binding FilesystemListing}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock
                    DoubleTap="FilesystemItem_OnTap"
                    FontSize="{StaticResource PhoneFontSizeLarge}"
                    Text="{Binding Description}" />
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</UserControl>