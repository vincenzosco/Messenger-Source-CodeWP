<UserControl x:Class="Facebook.Messenger.WP8.Controls.Internal.AudioLevels"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480"
    Loaded="AudioLevels_OnLoaded">

    <ScrollViewer>
        <StackPanel
            Margin="10,0,0,0"
            Orientation="Vertical">
            
            <StackPanel
                x:Name="AudioSettingsStackPanel"/>
            
            <Button
                Content="{Binding InternalStringsLibrary.Internal_Settings_Audio_Copy, Source={StaticResource LocalizedStrings}}"
                Tap="CopyAudioData_OnTap"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>