<base:BaseControl x:Class="Facebook.Messenger.WP8.Controls.StateIndicatingProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <Storyboard x:Name="IntermediateIn">
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="StateTransform"
                    Storyboard.TargetProperty="Y">
                    <LinearDoubleKeyFrame Value="-40" KeyTime="0:0:0" />
                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.4" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Name="NextStateIn">
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="CompletedStateTransform"
                    Storyboard.TargetProperty="Y">
                    <LinearDoubleKeyFrame Value="-40" KeyTime="0:0:0" />
                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.4" />
                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:3.4" />
                    <LinearDoubleKeyFrame Value="-40" KeyTime="0:0:3.8" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Name="IntermediateOut">
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="StateTransform"
                    Storyboard.TargetProperty="Y">
                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0" />
                    <LinearDoubleKeyFrame Value="-40" KeyTime="0:0:0.4" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <controls:FBMessengerProgressBar x:Name="FbProgressBar"/>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock x:Name="State"
                       Margin="5,0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="StateTransform" Y="-40"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="CompletedState"
                       Margin="5,0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="CompletedStateTransform" Y="-40"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</base:BaseControl>