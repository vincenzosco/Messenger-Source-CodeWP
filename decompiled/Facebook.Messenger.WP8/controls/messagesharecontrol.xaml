<base:BaseControl x:Class="Facebook.Messenger.WP8.Controls.MessageShareControl"
             x:Name="MessageShareControlRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
             mc:Ignorable="d"
             FontFamily="{StaticResource PhoneFontFamilyNormal}"
             FontSize="{StaticResource PhoneFontSizeNormal}"
             Foreground="{StaticResource PhoneForegroundBrush}"
             d:DesignHeight="480" d:DesignWidth="480"
             Tap="MessageShareOnTap">

    <StackPanel Background="Transparent">
        <Border BorderBrush="{StaticResource MessengerBorderGreyBrush}" 
            Margin="0,20,0,18" 
            BorderThickness="0,1.25,0,0" 
            Background="Transparent"
            x:Name="Border"/>
        <Grid x:Name="MessageShareLayoutRoot" 
              Margin="0,0,0,2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Grid.Row="0"
                  Width="80" 
                  Height="80"
                  Margin="0,0,10,5"
                  x:Name="ImageGrid">
                <Image x:Name="ImageHolder" 
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel  Grid.Row="0" 
                         Grid.Column="1">
                <TextBlock  x:Name="ShareName"
                            VerticalAlignment="Top"
                            FontWeight="Bold" 
                            MaxHeight="50" 
                            TextTrimming="WordEllipsis" 
                            TextWrapping="Wrap" 
                            Style="{StaticResource MessageText}" 
                            FontSize="18"/>
                <TextBlock  x:Name="Caption"
                            VerticalAlignment="Top"
                            Style="{StaticResource MessageText}"
                            FontSize="18"
                            TextTrimming="WordEllipsis"/>
            </StackPanel>
            <TextBlock  x:Name="Description"
                        Grid.Row="1" 
                        Grid.Column="0" 
                        Grid.ColumnSpan="2" 
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Stretch" 
                        TextWrapping="Wrap" 
                        MaxHeight="75" 
                        TextTrimming="WordEllipsis" 
                        Style="{StaticResource MessageText}"
                        FontSize="18" />
        </Grid>
    </StackPanel>
</base:BaseControl>