<UserControl x:Class="Facebook.Messenger.WP8.Controls.InternalSettingsAudioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">

    <StackPanel Orientation="Vertical">

        <TextBlock
            Text="{Binding Name}"
            FontSize="{StaticResource PhoneFontSizeLarge}"/>
        
        <StackPanel Orientation="Horizontal">
            
            <TextBlock
                Text="{Binding InternalStringsLibrary.Internal_Settings_Audio_Volume, Source={StaticResource LocalizedStrings}}"
                FontSize="{StaticResource PhoneFontSizeMedium}"
                VerticalAlignment="Center" />

            <TextBox
                x:Name="VolumeTextBox"
                Text="{Binding Volume}"
                Width="150"
                KeyUp="VolumeControl_OnKeyUp"
                LostFocus="VolumeControl_OnLostFocus"/>
            
            <Button
                Content="{Binding InternalStringsLibrary.Internal_Settings_Audio_Play, Source={StaticResource LocalizedStrings}}"
                Tap="PlayButton_OnTap"/>
            
        </StackPanel>

    </StackPanel>
</UserControl>