<UserControl x:Class="Facebook.Messenger.WP8.Controls.ActiveUsersListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480">
    
    
    <Grid x:Name="LayoutRoot">
        <base:FacebookListView 
            Grid.Row="0"
            x:Name="ActiveUsersList"
            ItemsSource="{Binding ActiveUsers}"
            Visibility="{Binding IsChatEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
            <base:FacebookListView.ItemTemplate>
                <DataTemplate>
                    <controls:ActiveUsersControl
                        Tap="OnItemTapped"/>
                </DataTemplate>
            </base:FacebookListView.ItemTemplate>
        </base:FacebookListView>
        
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Visibility="{Binding IsChatEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1}">
            <TextBlock
                Text="{Binding StringLibrary.Chat_Is_Off, Source={StaticResource LocalizedStrings}}"
                TextAlignment="Center"
                FontSize="37"
                FontFamily="Segoe WP SemiLight "
                Foreground="Black"/>
            <TextBlock
                Text="{Binding StringLibrary.Chat_Is_Off_Details_Label, Source={StaticResource LocalizedStrings}}"
                TextAlignment="Center"
                Margin="50, 10, 50, 0"
                FontSize="20"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                Foreground="{StaticResource PhonePageTextGrayBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>