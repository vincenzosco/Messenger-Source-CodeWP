<UserControl x:Class="Facebook.Messenger.WP8.Controls.ImageDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:Facebook.Messenger.WP8.Controls.Base"
    xmlns:controls="clr-namespace:Facebook.Messenger.WP8.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DesignHeight="480" d:DesignWidth="480"
    d:DataContext="{d:DesignInstance controls:ImageDrawer}">
    
    <Grid x:Name="LayoutRoot">

        <Grid
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1}">
            
            <TextBlock
                Visibility="{Binding ItemsSource.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=1}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                x:Name="EmptyGalleryText"
                Margin="30,0"
                TextAlignment="Center"
                FontSize="{StaticResource PhoneFontSizeMedium}"
                Foreground="{StaticResource MessengerTextDarkGreyBrush}"
                Text="{Binding EmptyListText}"/>
            
            <base:FacebookListView
                x:Name ="ImageList"
                Visibility="{Binding ItemsSource.Count, Converter={StaticResource BoolToVisibilityConverter}}"
                RenderTransformOrigin="0.5, 0.5"
                SelectionChanged="SelectionChanged"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ViewportChanged="ListboxScrolled"
                ItemsSource="{Binding ItemsSource}">

                <base:FacebookListView.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </base:FacebookListView.RenderTransform>

                <base:FacebookListView.ItemTemplate>
                    <DataTemplate>
                        <controls:ImageDrawerDrawerItem
                            OverlayTapped="OverlayTapped"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="12,4,0,0"
                            RenderTransformOrigin="0.5, 0.5"
                            EditClicked="EditButtonClicked"
                            SendClicked="SendButtonClicked">

                            <controls:ImageDrawerDrawerItem.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </controls:ImageDrawerDrawerItem.RenderTransform>

                        </controls:ImageDrawerDrawerItem>
                    </DataTemplate>
                </base:FacebookListView.ItemTemplate>

            </base:FacebookListView>
        </Grid>

        <controls:FBMessengerProgressBar 
            x:Name="LoadingBar"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            IsIndeterminate="{Binding IsLoading}"
            VerticalAlignment="Center"/>

    </Grid>
</UserControl>