    <SolidColorBrush x:Key="MessengerTextBlackBrush" Color="{StaticResource MessengerTextBlack}"/>
    <SolidColorBrush x:Key="MessengerChatBubbleGreyBrush" Color="{StaticResource MessengerChatBubbleGrey}"/>
    <SolidColorBrush x:Key="MessengerPlaceholderTextGreyBrush" Color="{StaticResource MessengerPlaceholderTextGrey}"/>
