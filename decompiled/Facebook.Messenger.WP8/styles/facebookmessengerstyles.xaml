    <Style TargetType="controls:BubbleContainer">
        <Setter Property="Background" Value="{StaticResource MessageBubbleBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:BubbleContainer">
                    <Grid
                        x:Name="BubbleGrid"
                        VerticalAlignment="Center"
                        HorizontalAlignment="{TemplateBinding BubbleAlignment}"
                        Background="Transparent">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Polygon
                            x:Name="TopTriangle"
                            Margin="12,0,0,-1"
                            HorizontalAlignment="Left"
                            Grid.Row="0"
                            Points="0,0 0,16 20,16"
                            Fill="{TemplateBinding Background}"
                            Visibility="{TemplateBinding TopNubVisibility}"
                            Stretch="Fill"
                            Canvas.ZIndex="1"
                            Width="17"
                            Height="12" />

                        <Polygon
                            x:Name="BottomTriangle"
                            Margin="0,-1,12,0"
                            HorizontalAlignment="Right"
                            Grid.Row="2"
                            Points="0,0 20,0 20,16"
                            Fill="{TemplateBinding Background}"
                            Visibility="{TemplateBinding BottomNubVisibility}"
                            Stretch="Fill"
                            Canvas.ZIndex="1"
                            Width="17"
                            Height="12" />

                        <Polygon
                            x:Name="BottomTriangleOverlay"
                            Margin="0,-13,15,0"
                            HorizontalAlignment="Right"
                            Grid.Row="2"
                            Points="0,0 20,0 20,16"
                            Fill="{TemplateBinding BubbleFill}"
                            Visibility="{TemplateBinding BottomNubVisibility}"
                            Stretch="Fill"
                            Canvas.ZIndex="2"
                            Width="17"
                            Height="12" />

                        <Border
                            x:Name="BubbleBorder"
                            Grid.Row="1"
                            Padding="5"
                            Background="{TemplateBinding BubbleFill}"
                            BorderBrush="{TemplateBinding Background}"
                            BorderThickness="3">

                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MessageComposerHintTextStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="15, 0, 0, 0" />
    </Style>

    <Style x:Key="BareTiltButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="{StaticResource PhoneTouchTargetOverhang}" />
        <Setter Property="Padding"  Value="0"/>
        <Setter Property="ex:TiltEffect.IsTiltEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver"/>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="ContentContainer">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MessengerButtonPressedBlue}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="ContentContainer">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhoneDisabledBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                                x:Name="ButtonBackground" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="0"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="0">
                            <ContentControl 
                                    x:Name="ContentContainer" 
                                    ContentTemplate="{TemplateBinding ContentTemplate}" 
                                    Content="{TemplateBinding Content}" 
                                    Foreground="{TemplateBinding Foreground}" 
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                    Padding="{TemplateBinding Padding}" 
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

