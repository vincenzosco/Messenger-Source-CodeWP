    <!-- Link Styled Button - allows links to be presented and easy binding to commands -->
    <Style x:Key="LinkStyleButton" BasedOn="{StaticResource BareTiltButton}" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MessengerBlueBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PhoneFontFamilyLight}"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeSmall}"/>
        <Setter Property="Padding"  Value="10"/>
        <Setter Property="ex:TiltEffect.IsTiltEnabled" Value="False" />
