                            <ContentControl x:Name="ContentElement" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="{TemplateBinding Padding}" VerticalContentAlignment="Stretch" Content=""/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Name="LargePhoneNumberTextBoxStyle" BasedOn="{StaticResource LoginTextBoxStyle2}" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeExtraLarge}"/>
        <Setter Property="Height" Value="75"/>
    </Style>

    <Style x:Key="HintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="Foreground"  Value="{StaticResource MessengerPlaceholderTextGreyBrush}"/>
        <Setter Property="Padding"  Value="15,10,10,10"/>
    </Style>

    <ControlTemplate x:Key="PhoneDisabledPasswordBoxTemplate" TargetType="PasswordBox">
        <Border x:Name="ContentElement" BorderThickness="0" Padding="12,4,3,0"/>
    </ControlTemplate>

